QUEUE_DB=./.data/test/queue.db
LOCAL_CACHE_DIR=./.data/test/cache
KV_PATH=./.data/test/kv.db

# Never let test runs touch a real S3 bucket — .env (real staging/production
# credentials) would otherwise leak through for any key not overridden here.
S3_BUCKET=

# Small enough that the rate-limit test in tests/app.test.ts only needs a
# couple dozen sequential requests to trip 429, instead of the production
# default of 300+1 real SQLite-backed round trips. That loop left ~30%
# headroom under bun's 5000ms test timeout even with zero contention, so it
# flaked whenever other moon test tasks ran concurrently and contended for
# CPU. Kept above 1 so the "not yet limited" requests before the trip are
# still exercised.
RATE_LIMIT_MAX=20
