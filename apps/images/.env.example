HTTP_DOMAINS=
HTTP_MAX_AGE=0
FS_DIR=./assets/images
FS_MAX_AGE=0
LOCAL_CACHE_DIR=./.data/cache
MAX_CONCURRENT=3
S3_ENDPOINT=https://s3.amazonaws.com
S3_PORT=9000
S3_USE_SSL=true
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
CONSOLA_LEVEL=3
AVIF_ENABLED=true
KV_PATH=./.data/kv.db
KV_MAX_BYTES=52428800
BAN_STRIKE_THRESHOLD=5
BAN_STRIKE_WINDOW_MS=3600000
BAN_DURATION_MS=86400000
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=300
TRUST_CLOUDFLARE_IPS=true
