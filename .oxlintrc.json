{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "no-unused-vars": "error",
    "no-unused-expressions": ["error", { "allowShortCircuit": true }],
    "id-length": "off",
    "new-cap": "off",
    "max-params": "off",
    "max-statements": "off",
    "capitalized-comments": "off",
    "oxc/no-accumulating-spread": "error",
    "import/no-unassigned-import": "off",
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",

    "eslint/no-duplicate-imports": [
      "error",
      {
        "allowSeparateTypeImports": true
      }
    ],
    "eslint/no-await-in-loop": "error",
    "eslint/no-magic-numbers": "off",
    "eslint/no-ternary": "off",
    // TypeScript already rejects use-before-assign; a bare `let x: T` is clearer
    // than `let x: T | undefined = undefined`, and Svelte `bind:this` needs it.
    "eslint/init-declarations": "off",
    // Guard-clause `continue` is idiomatic.
    "eslint/no-continue": "off",
    // Portable Text / Sanity-shaped fields.
    "eslint/no-underscore-dangle": [
      "error",
      { "allow": ["_key", "_ref", "_type", "_id"] }
    ],
    "eslint/one-var": "off",

    // Unicorn rules
    "unicorn/filename-case": "off",
    "unicorn/no-empty-file": "error",
    "unicorn/no-null": "off",

    "jest/require-hook": "off",

    // Enforce function expressions over declarations for consistency
    "eslint/func-style": ["error", "expression"],

    "typescript/triple-slash-reference": "off",
    "typescript/consistent-type-definitions": ["error", "type"],
    // Disabled until auto-fix support is added
    "sort-keys": "off",
    "eslint/sort-imports": "off",
    "curly": ["error", "multi-or-nest"]
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "style": "error",
    "perf": "error"
  },
  "plugins": [
    // Defaults
    "eslint",
    "typescript",
    "oxc",
    // Extras
    "jest",
    "import",
    "promise",
    "node"
  ],
  "ignorePatterns": [
    "dist/",
    "test/snapshots/**",
    "coverage/",
    "emdash-env.d.ts"
  ],
  "overrides": [
    {
      "files": ["**/*.tsx", "**/*.ts"],
      "rules": {
        "import/no-namespace": "off",
        "import/group-exports": "off"
      }
    },
    {
      "files": [
        "**/*.server.tsx",
        "**/*.server.ts",
        "scripts/**/*.ts",
        "playwright.config.ts"
      ],
      "rules": {
        "import/no-nodejs-modules": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "import/no-nodejs-modules": "off",
        "import/first": "off"
      }
    },
    {
      "files": ["**/*.astro"],
      "rules": {
        "import/exports-last": "off",
        "typescript/consistent-type-imports": "off",
        "import/group-exports": "off"
      }
    },
    {
      // Node-only tooling: scripts, tests and build config run on Node, not in a Worker.
      "files": [
        "scripts/**/*.ts",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.config.{ts,js,mjs}",
        "**/vite-*.js",
        "svelte-loader.ts"
      ],
      "rules": {
        "node/no-sync": "off",
        "import/no-nodejs-modules": "off"
      }
    },
    {
      // Sequential awaits are intentional: ordered browser steps and test setup.
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "scripts/ci/pedrohenridesign-browser.ts"
      ],
      "rules": { "eslint/no-await-in-loop": "off" }
    },
    {
      "files": ["*.config.{ts,js,mjs}"],
      "rules": {
        "import/no-nodejs-modules": "off",
        "import/no-named-as-default-member": "off",
        "import/no-anonymous-default-export": "off",
        "import/default": "off"
      }
    }
  ]
}
