{
  "extends": ["../../tsconfig.bundler.json", "astro/tsconfigs/base"],
  "include": ["src/**/*", "tests/**/*", "*.js", "*.ts", "./package.json"],
  "compilerOptions": {
    "outDir": "../../.moon/cache/types/packages/sun-ui",
    "allowJs": true,
    "allowArbitraryExtensions": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "noEmit": false
  },
  "plugins": [{ "name": "@astrojs/ts-plugin" }]
}
