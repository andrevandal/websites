---
import type { CarouselProps } from "./Carousel.props.ts"
import { cn } from "../../index"

type Props = CarouselProps

const {
  className = "",
  autoScroll = true,
  direction = "right-to-left",
  speed = 40,
} = Astro.props
---

<div
  data-carousel="container"
  data-carousel-autoscroll={autoScroll ? "true" : "false"}
  data-carousel-direction={direction}
  data-carousel-speed={speed}
>
  <div
    data-carousel="track"
    tabindex="0"
    class={cn(
      "flex cursor-grab snap-x snap-mandatory scrollbar-none flex-row flex-nowrap gap-x-6 overflow-x-auto select-none active:cursor-grabbing",
      className
    )}
  >
    <slot />
  </div>
</div>

<script>
  const CAROUSEL_DIRECTIONS = ["left-to-right", "right-to-left"] as const
  type CarouselDirection = (typeof CAROUSEL_DIRECTIONS)[number]

  const isCarouselDirection = (
    value: string | undefined
  ): value is CarouselDirection =>
    (CAROUSEL_DIRECTIONS as readonly string[]).includes(value ?? "")

  const RESUME_DELAY_MS = 500

  const init = (container: HTMLElement | null, track: HTMLElement | null) => {
    if (!container || !track) {
      console.error("Carousel: container or track element not found")
      return
    }

    const autoScroll = container.dataset.carouselAutoscroll === "true"
    const { carouselDirection } = container.dataset
    const direction = isCarouselDirection(carouselDirection)
      ? carouselDirection
      : "right-to-left"
    const speed = Number(container.dataset.carouselSpeed) || 40

    let isDown = false
    let startX = 0
    let scrollLeft = 0
    let snapEnabled = true

    const getGap = () =>
      Number(
        getComputedStyle(track).getPropertyValue("column-gap").replace("px", "")
      )

    const getContentWidth = () => {
      const children = [...track.children]
      return (
        children.reduce((acc, el) => acc + el.clientWidth, 0) +
        getGap() * (children.length - 1)
      )
    }

    const updateSnapState = () => {
      if (container.clientWidth >= getContentWidth()) {
        snapEnabled = false
        track.style.scrollSnapType = "none"
        track.classList.add("mx-auto", "w-fit")
      } else {
        snapEnabled = true
        track.style.scrollSnapType = ""
        track.classList.remove("mx-auto", "w-fit")
      }
    }

    if (!autoScroll) {
      new ResizeObserver(updateSnapState).observe(container)
      updateSnapState()
    }

    if (autoScroll && track.children.length > 0) {
      track.style.scrollSnapType = "none"

      const originalSlides = [...track.children] as HTMLElement[]
      originalSlides.forEach(slide => {
        // Infinite loop needs a perfectly uniform, periodic layout: strip
        // the edge-only breathing margins (first/last child) so the cloned
        // set lines up exactly with the original set.
        slide.style.marginLeft = "0px"
        slide.style.marginRight = "0px"
        const clone = slide.cloneNode(true) as HTMLElement
        clone.setAttribute("aria-hidden", "true")
        clone.setAttribute("inert", "")
        track.append(clone)
      })
      const firstOriginal = originalSlides[0] as HTMLElement
      const firstClone = track.children[originalSlides.length] as HTMLElement
      const directionSign = direction === "left-to-right" ? -1 : 1
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches

      let pos = track.scrollLeft
      let lastTime: number | undefined = undefined
      let rafId: number | undefined = undefined

      const getLoopWidth = () =>
        firstClone.offsetLeft - firstOriginal.offsetLeft

      const step = (time: number) => {
        if (lastTime === undefined) lastTime = time
        const dt = (time - lastTime) / 1000
        lastTime = time
        const loopWidth = getLoopWidth()
        pos += directionSign * speed * dt
        if (loopWidth > 0) pos = ((pos % loopWidth) + loopWidth) % loopWidth
        track.scrollLeft = pos
        rafId = requestAnimationFrame(step)
      }

      const startAutoScroll = () => {
        if (rafId !== undefined || reduceMotion) return
        pos = track.scrollLeft
        lastTime = undefined
        rafId = requestAnimationFrame(step)
      }

      const stopAutoScroll = () => {
        if (rafId === undefined) return
        cancelAnimationFrame(rafId)
        rafId = undefined
      }

      const pauseReasons = new Set<string>()
      let resumeTimer: ReturnType<typeof setTimeout> | undefined = undefined

      const pause = (reason: string) => {
        pauseReasons.add(reason)
        clearTimeout(resumeTimer)
        stopAutoScroll()
      }

      const scheduleResume = (reason: string) => {
        pauseReasons.delete(reason)
        if (pauseReasons.size > 0) return
        clearTimeout(resumeTimer)
        resumeTimer = setTimeout(() => {
          if (pauseReasons.size === 0) startAutoScroll()
        }, RESUME_DELAY_MS)
      }

      // Desktop: pause while the pointer hovers the carousel.
      container.addEventListener("mouseenter", () => pause("hover"))
      container.addEventListener("mouseleave", () => scheduleResume("hover"))
      // Keyboard: pause while a slide/track has focus.
      track.addEventListener("focusin", () => {
        if (track.matches(":focus-visible")) pause("focus")
      })
      track.addEventListener("focusout", () => scheduleResume("focus"))
      // Mobile + desktop drag: pause for the duration of the touch/click.
      track.addEventListener("pointerdown", () => pause("pointer"))
      window.addEventListener("pointerup", () => scheduleResume("pointer"))
      window.addEventListener("pointercancel", () => scheduleResume("pointer"))

      startAutoScroll()
    }

    track.addEventListener("mousedown", e => {
      if (!snapEnabled) return
      isDown = true
      startX = e.pageX - track.offsetLeft
      // oxlint-disable-next-line prefer-destructuring
      scrollLeft = track.scrollLeft
      track.style.scrollSnapType = "none"
    })

    track.addEventListener("mouseleave", () => {
      if (!isDown) return
      isDown = false
      if (snapEnabled && !autoScroll) track.style.scrollSnapType = "x mandatory"
    })

    track.addEventListener("mouseup", () => {
      if (!isDown) return
      isDown = false
      if (snapEnabled && !autoScroll) track.style.scrollSnapType = "x mandatory"
    })

    track.addEventListener("mousemove", e => {
      if (!isDown) return
      e.preventDefault()
      const x = e.pageX - track.offsetLeft
      track.scrollLeft = scrollLeft - (x - startX) * 1.5
    })

    track.addEventListener("keydown", e => {
      if (!snapEnabled) return
      if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return
      e.preventDefault()
      const slide = track.firstElementChild as HTMLElement | null
      if (!slide) return
      const delta =
        (e.key === "ArrowRight" ? 1 : -1) * (slide.offsetWidth + getGap())
      track.scrollBy({ left: delta, behavior: "smooth" })
    })
  }

  const containers = document.querySelectorAll<HTMLElement>(
    '[data-carousel="container"]'
  )

  containers.forEach(container => {
    const track = container?.querySelector<HTMLElement>(
      '[data-carousel="track"]'
    )
    init(container, track)
  })
</script>
<style>
  @reference "tailwindcss";
</style>
