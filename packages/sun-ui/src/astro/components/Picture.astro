---
import { getSecret } from "astro:env/server"
import type { SunPictureProps } from "./Picture.props.ts"
import {
  getPlaceholderUrl,
  buildImageUrl,
  buildImageSrcSet,
} from "../../astro-image-service"
import {
  DENSITIES,
  buildPictureSourceProps,
  computeResponsiveImageProps,
  getPlaceholderModeAttribute,
} from "./Picture.utils"
import { runtimeEnv } from "../runtime-env"
import { cn } from "../../index"

type Props = SunPictureProps

const imageServiceBaseUrl = runtimeEnv(getSecret, "IMAGES_BASE_URL")

const {
  src,
  alt,
  width,
  height,
  quality,
  format,
  fit,
  densities = DENSITIES,
  breakpoints,
  sources,
  placeholder = true,
  placeholderMode,
  class: className,
  wrapperClass,
  loading,
  decoding,
  ...rest
} = Astro.props

const placeholderUrl =
  placeholder && imageServiceBaseUrl
    ? getPlaceholderUrl(imageServiceBaseUrl, src)
    : undefined
const placeholderModeAttribute = placeholderUrl
  ? getPlaceholderModeAttribute(placeholderMode)
  : undefined

const { responsiveWidths, sizes } = computeResponsiveImageProps({
  width,
  densities,
  breakpoints,
})

const hasSources = Boolean(sources?.length)
const Wrapper = hasSources ? "picture" : "div"
---

<Wrapper
  class={cn("sun-picture relative isolate block overflow-hidden", wrapperClass)}
  data-sun-picture-placeholder={placeholderUrl ? "" : undefined}
  data-sun-picture-placeholder-mode={placeholderModeAttribute}
  style={{
    ...(placeholderUrl
      ? { "--sun-picture-placeholder-url": `url("${placeholderUrl}")` }
      : undefined),
    "--ratio": [width, height].join("/"),
  }}
>
  {
    hasSources &&
      sources?.map(source => (
        <source
          {...buildPictureSourceProps({
            ...source,
            quality,
            format,
            fit,
            densities,
            imageServiceBaseUrl,
          })}
        />
      ))
  }
  {
    imageServiceBaseUrl ? (
      responsiveWidths ? (
        (() => {
          const srcsetEntries = buildImageSrcSet({
            src,
            width,
            height,
            quality,
            format,
            fit,
            widths: responsiveWidths,
          })
          const srcset = srcsetEntries
            .map(
              entry =>
                `${buildImageUrl(imageServiceBaseUrl, entry.transform)} ${entry.descriptor}`
            )
            .join(", ")
          return (
            <img
              src={buildImageUrl(imageServiceBaseUrl, {
                src,
                width,
                height,
                quality,
                format,
                fit,
              })}
              srcset={srcset}
              sizes={hasSources && rest.sizes !== undefined ? undefined : sizes}
              alt={alt}
              width={hasSources ? width : undefined}
              height={hasSources ? height : undefined}
              loading={loading}
              decoding={decoding}
              class={cn(!hasSources && "aspect-(--ratio)", className)}
              {...rest}
            />
          )
        })()
      ) : (
        (() => {
          const srcsetEntries = buildImageSrcSet({
            src,
            width,
            height,
            quality,
            format,
            fit,
            densities,
          })
          const srcset = srcsetEntries
            .map(
              entry =>
                `${buildImageUrl(imageServiceBaseUrl, entry.transform)} ${entry.descriptor}`
            )
            .join(", ")
          return (
            <img
              src={buildImageUrl(imageServiceBaseUrl, {
                src,
                width,
                height,
                quality,
                format,
                fit,
              })}
              srcset={srcset}
              alt={alt}
              width={hasSources ? width : undefined}
              height={hasSources ? height : undefined}
              loading={loading}
              decoding={decoding}
              class={cn(!hasSources && "aspect-(--ratio)", className)}
              {...rest}
            />
          )
        })()
      )
    ) : (
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding={decoding}
        class={cn(!hasSources && "aspect-(--ratio)", className)}
        {...rest}
      />
    )
  }
</Wrapper>

{
  placeholderUrl && (
    <noscript
      set:html={`<style>.sun-picture[data-sun-picture-placeholder]::before{display:none!important}</style>`}
    />
  )
}

<style>
  /* `.sun-picture` scopes the placeholder rules; layout comes from utilities. */
  .sun-picture[data-sun-picture-placeholder]::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image: var(--sun-picture-placeholder-url);
    background-size: cover;
    background-position: center;
    filter: blur(20px);
    transform: scale(1.1);
    opacity: 1;
    pointer-events: none;
    transition: opacity 300ms ease-out;
  }

  .sun-picture[data-sun-picture-placeholder-mode="circle"]::before {
    -webkit-mask-image: radial-gradient(circle, #000 25%, #0000 60%);
    mask-image: radial-gradient(circle, #000 25%, #0000 60%);
  }

  .sun-picture[data-placeholder-loaded]::before {
    opacity: 0;
  }

  .sun-picture :global(img) {
    position: relative;
    z-index: 2;
    display: block;
  }
</style>

<script>
  const PLACEHOLDER = "[data-sun-picture-placeholder]"

  const revealImage = (wrapper: HTMLElement) => {
    wrapper.setAttribute("data-placeholder-loaded", "")
  }

  const watchImage = (wrapper: HTMLElement) => {
    const image = wrapper.querySelector("img")
    if (!image) return

    if (image.complete) revealImage(wrapper)
    else {
      image.addEventListener("load", () => revealImage(wrapper), {
        once: true,
      })
      image.addEventListener("error", () => revealImage(wrapper), {
        once: true,
      })
    }
  }

  document.querySelectorAll<HTMLElement>(PLACEHOLDER).forEach(watchImage)

  // Pictures inserted after load (e.g. fetched HTML fragments) need the same
  // reveal; scripts inside inserted HTML never run.
  new MutationObserver(records => {
    for (const record of records) {
      for (const node of record.addedNodes) {
        if (node instanceof HTMLElement) {
          if (node.matches(PLACEHOLDER)) watchImage(node)
          node.querySelectorAll<HTMLElement>(PLACEHOLDER).forEach(watchImage)
        }
      }
    }
  }).observe(document.body, { childList: true, subtree: true })
</script>
