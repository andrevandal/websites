---
import { YouTube } from "@astro-community/astro-embed-youtube"
import type { YoutubeProps as Props } from "./Youtube.props"
import { cn } from "../../index"

const {
  videoId,
  poster,
  posterQuality,
  params,
  playlabel = "Play",
  title,
  class: className,
  id: _,
  ...props
} = Astro.props as Props
---

<style>
  lite-youtube {
    max-width: unset;
  }
</style>

{
  videoId && (
    <YouTube
      id={videoId}
      poster={poster}
      posterQuality={posterQuality}
      params={params}
      playlabel={playlabel}
      title={title}
      class={cn("not-prose w-full max-w-[unset]", className)}
      {...props}
    />
  )
}
