{
  "extends": "./tsconfig.options.json",
  "compilerOptions": {
    // See: https://moonrepo.dev/docs/guides/javascript/typescript-project-refs#tsconfigoptionsjson
    "emitDeclarationOnly": true,
    "declaration": true,
    "noEmit": false,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  }
}
