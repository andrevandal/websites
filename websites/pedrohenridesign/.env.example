# GitHub preview build inputs, not Worker runtime vars. Default flavor: standard.
# Only selected CI previews set preview; astro dev always uses .data/ instead.
EMDASH_BUILD_FLAVOR=standard
# GitHub secret for preview builds only: hostname or full HTTP(S) team URL.
CF_ACCESS_TEAM_DOMAIN=

# Cloudflare Workers Preview Base runtime secret only; never passed to builds.
CF_ACCESS_AUDIENCE=

# Public image-service URL comes from the deploying GitHub environment.
# Leave IMAGES_BASE_URL empty locally: dev serves the seeded originals
# from .data/uploads.
IMAGES_BASE_URL=
# Optional Stage var: S3_REGION (default auto).

# Standard staging/production runtime secrets from Infisical
# /websites/pedrohenridesign (staging and production), injected at upload.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Dev and Preview Base also need the staging endpoint/bucket for public branding
# assets only; they never use the S3 credentials for local/preview CMS media.
S3_ENDPOINT=
S3_BUCKET=
# Optional Stage var: S3_REGION (default auto); S3_PUBLIC_URL (derived from
# S3_ENDPOINT and S3_BUCKET if absent; never commit its value).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Encrypts plugin secret settings (JMAP credential). Generate with
# `bunx emdash secrets generate`; each Stage needs its own.
EMDASH_ENCRYPTION_KEY=
