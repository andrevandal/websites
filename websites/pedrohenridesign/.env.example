# GitHub preview build inputs, not Worker runtime vars. Default flavor: standard.
# Only selected CI previews set preview; astro dev always uses .data/ instead.
EMDASH_BUILD_FLAVOR=standard
# GitHub secret for preview builds only: hostname or full HTTP(S) team URL.
CF_ACCESS_TEAM_DOMAIN=

# Cloudflare Workers Preview Base runtime secret only; never passed to builds.
CF_ACCESS_AUDIENCE=

# Non-secret values. Keep images/analytics/Partytown per Stage in config.json.
# Leave IMAGES_BASE_URL empty locally: dev serves the originals (the seeded
# media is stored in .data/uploads). Each Stage sets its own in config.json.
IMAGES_BASE_URL=
ENABLE_PARTYTOWN=
# Optional Stage vars: S3_REGION (default auto) and S3_PUBLIC_URL (CDN base URL).

# Standard staging/production runtime secrets only; in CI they are the JSON
# PEDROHENRI_SECRETS of the GitHub staging/production environments.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
