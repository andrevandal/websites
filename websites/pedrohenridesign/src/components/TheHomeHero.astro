---
import { SunPicture } from "@vandal-websites/sun-ui/astro"
import { DENSITIES, fileUrl } from "@/utils/images"
import BaseButton from "./BaseButton.astro"
---

<section
  class="flex flex-col rounded-lg bg-gray-50 py-4 sm:pb-6 lg:grid lg:grid-cols-12 lg:items-center lg:justify-between lg:gap-x-6 lg:px-8 lg:py-8"
>
  <div
    class="order-2 flex flex-1 flex-col gap-2 px-4 sm:px-6 lg:order-1 lg:col-span-7 lg:col-start-1 lg:px-0"
  >
    <h1 class="typography-title max-w-[38ch] font-extrabold text-gray-900">
      Em um mundo<br />
      cheio de barulho,<br />
      design fala mais alto.
    </h1>
    <p class="mb-4 max-w-[38ch] text-xl text-gray-900 lg:text-2xl">
      As marcas com crescimento mais expressivo são aquelas que valorizam e
      investem em design.
    </p>
    <BaseButton
      icon="arrow-down"
      href="/#identidade-visual"
      variant="primary"
      size="medium"
      class="w-full! sm:w-fit!"
      increaseSize
    >
      Conheça meu trabalho
    </BaseButton>
  </div>
  <div
    class="order-1 flex h-auto w-full flex-1 px-4 lg:order-2 lg:col-span-5 lg:col-start-8 lg:px-0"
  >
    <SunPicture
      src={fileUrl("images/primeira-dobra.png")}
      width={400}
      height={444}
      alt="Pedro Henrique pensativo segurando sua caneta (da mesa digitalizadora) olhado para frente."
      breakpoints={[
        { minWidth: 1024, width: 359 },
        { minWidth: 1280, width: 466 },
      ]}
      densities={DENSITIES}
      sizes="(min-width: 1280px) 466px, (min-width: 1024px) 359px, (min-width: 464px) 400px, calc(100vw - 64px)"
      class="aspect-9/10 h-auto w-full"
      wrapperClass="w-full"
      loading="eager"
    />
  </div>
</section>

<section
  class="flex flex-col gap-y-6 lg:grid lg:grid-cols-12 lg:flex-row lg:items-center lg:justify-between lg:gap-x-6"
>
  <div class="order-1 lg:order-2 lg:col-span-5 lg:col-start-8 lg:flex-1">
    <SunPicture
      src={fileUrl("images/sessao_crio-para-marcas.png")}
      width={432}
      height={432}
      alt="Pedro Henrique pensativo segurando sua caneta (da mesa digitalizadora) sentado em sua cadeira. Algo comum em seu cotidiano."
      breakpoints={[
        { minWidth: 1024, width: 359 },
        { minWidth: 1280, width: 466 },
      ]}
      densities={DENSITIES}
      sizes="(min-width: 1280px) 466px, (min-width: 1024px) 359px, (min-width: 464px) 432px, calc(100vw - 32px)"
      class="aspect-square h-auto w-full rounded-lg"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div
    class="order-2 lg:order-1 lg:col-span-7 lg:col-start-1 lg:flex lg:flex-1 lg:flex-col lg:justify-center lg:px-0"
  >
    <h2 class="typography-title max-w-[38ch] font-extrabold text-gray-900">
      Crio para marcas que ousam inovar e crescer.
    </h2>
    <p class="mt-2 max-w-[38ch] text-xl text-gray-900 lg:text-2xl">
      Use o design como uma vantagem competitiva para aumentar suas vendas e
      fortalecer o valor da sua marca no mercado.
    </p>
  </div>
</section>
