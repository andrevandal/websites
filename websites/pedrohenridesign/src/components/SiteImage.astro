---
import PkgImage from "@vandal-websites/astro/ui/Image"
import { SITE_IMAGE_CONFIG } from "../config/image"
import type { ComponentProps } from "astro/types"

type Props = Omit<ComponentProps<typeof PkgImage>, "imageConfig">

const { props } = Astro
---

<PkgImage imageConfig={SITE_IMAGE_CONFIG} {...props} />
