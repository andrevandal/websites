---
import { SunPicture } from "@vandal-websites/sun-ui/astro"
import { mediaSource, mediaFormat } from "@vandal-websites/sun-ui-emdash"
import { backgroundStyle, cornerClass } from "@/cms/blocks"
import type { PostContentPostImageBlock } from "../../../emdash-env"

type Props = {
  value: PostContentPostImageBlock
}

const { value } = Astro.props
const { image } = value

// base 432, breakpoints 896@1024 and 1152@1280
const width = 432
const height = Math.round((width * (image.height || 1)) / (image.width || 1))
---

<div
  class:list={[
    // Same rhythm as a prose paragraph; consecutive images sit flush.
    "post-image not-prose my-5 w-full first:mt-0 last:mb-0 [&:has(+.post-image)]:mb-0 [.post-image+&]:mt-0",
    cornerClass(value.corners, "lg"),
  ]}
  style={backgroundStyle(value.background)}
>
  <SunPicture
    src={mediaSource(image, Astro)}
    alt={image.alt ?? ""}
    width={width}
    height={height}
    breakpoints={[
      { minWidth: 1024, width: 896 },
      { minWidth: 1280, width: 1152 },
    ]}
    sizes="(min-width: 1280px) 1152px, (min-width: 1024px) 896px, (min-width: 464px) 432px, calc(100vw - 32px)"
    format={mediaFormat(image)}
    quality={90}
    class="my-0 h-auto w-full"
    wrapperClass="my-0 w-full"
  />
</div>
