---
import type { PortableTextBlock } from "emdash"
import { PortableText } from "emdash/ui"
import { portableTextComponents } from "@vandal-websites/sun-ui-emdash/astro"
import PTImage from "./PTImage.astro"

type Props = {
  value: PortableTextBlock[]
}

const { value } = Astro.props
---

<PortableText
  value={value}
  components={{ ...portableTextComponents, type: { image: PTImage } }}
/>
