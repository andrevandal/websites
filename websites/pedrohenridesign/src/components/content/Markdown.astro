---
import { toHast } from "mdast-util-to-hast"
import { toHtml } from "hast-util-to-html"
import Image from "./Image.astro"
import Youtube from "./Youtube.astro"
import type { RootContent, Root } from "mdast"

type NodeType = RootContent | Root
type Props = {
  node: RootContent | Root
}

const { node } = Astro.props

type CustomImage = RootContent & {
  type: "textDirective"
  attributes: {
    src: string
  }
}
type CustomYoutube = RootContent & {
  type: "textDirective"
  attributes: {
    id: string
  }
}
type CustomDiv = RootContent & {
  type: "containerDirective"
  attributes: {
    className?: string
  }
}

const isRoot = (n: NodeType) => n.type === "root"
const isParagraph = (n: NodeType) => n.type === "paragraph"
const isTextDirective = (n: NodeType) => n.type === "textDirective"
const isContainerDirective = (n: NodeType) => n.type === "containerDirective"

const isCustomImage = (n: NodeType): n is CustomImage =>
  isTextDirective(n) && n.name === "image" && Boolean(n.attributes?.src)

const isCustomYoutube = (n: NodeType): n is CustomYoutube =>
  isTextDirective(n) && n.name === "youtube" && Boolean(n.attributes?.id)

const isCustomDiv = (n: NodeType): n is CustomDiv =>
  isContainerDirective(n) && n.name === "div"

const isOtherType = (n: NodeType) =>
  !(
    isRoot(n) ||
    isParagraph(n) ||
    isCustomImage(n) ||
    isCustomYoutube(n) ||
    isCustomDiv(n)
  )
---

{isRoot(node) && node?.children.map((node: any) => <Astro.self node={node} />)}
{
  isParagraph(node) && (
    <p>
      {node.children.map((node: any) => (
        <Astro.self node={node} />
      ))}
    </p>
  )
}
{isCustomImage(node) && <Image {...node.attributes} />}
{isCustomYoutube(node) && <Youtube {...node.attributes} />}
{
  isCustomDiv(node) && (
    <div class:list={node.attributes?.className ?? ""}>
      {node.children.map((node: any) => (
        <Astro.self node={node} />
      ))}
    </div>
  )
}
{
  isOtherType(node) && (
    <Fragment set:html={toHtml(toHast(node, { allowDangerousHtml: true }))} />
  )
}
