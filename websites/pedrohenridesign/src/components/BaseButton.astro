---
import type { HTMLAttributes } from "astro/types"
import { SunButton, SunIcon } from "@vandal-websites/sun-ui/astro"
import { cn } from "@vandal-websites/sun-ui"

type Sizes = "small" | "medium" | "large"

type Props = {
  href?: string
  variant: "primary" | "primary-outline" | "secondary"
  icon?: string
  reverse?: boolean
  block?: boolean
  centered?: boolean
  size?: Sizes
  increaseSize?: boolean
} & HTMLAttributes<"a">

const {
  href,
  variant,
  icon,
  reverse,
  size,
  block = false,
  centered = false,
  increaseSize,
  class: className,
  ...attrs
} = Astro.props
---

<SunButton
  as="a"
  href={href}
  block={block}
  centered={centered}
  className={cn(
    "pedro-button",
    {
      "btn-primary": variant === "primary",
      "btn-primary-outline": variant === "primary-outline",
      "btn-secondary": variant === "secondary",
      "btn-reverse": reverse,
      "btn-small": size === "small",
      "btn-medium": size === "medium",
      "btn-large": size === "large",
      "btn-increased": increaseSize,
    },
    className
  )}
  {...attrs}
>
  <slot />
  {icon && <SunIcon slot="suffix" name={icon} width={20} height={20} />}
</SunButton>

<style>
  @reference "../styles/global.css";

  :global(.pedro-button) {
    @apply gap-x-2 rounded-lg px-6 py-4 text-base font-semibold transition-all duration-200 ease-out;
  }
  :global(.pedro-button.btn-large) {
    @apply h-14 px-6 py-4;
  }
  :global(.pedro-button.btn-medium) {
    @apply h-12 px-3 py-3;
    &.btn-increased {
      @apply lg:h-14 lg:px-6 lg:py-4;
    }
  }
  :global(.pedro-button.btn-small) {
    @apply h-10 px-6 py-2;
  }
  :global(.pedro-button.btn-primary) {
    @apply bg-gray-900 text-gray-50 ring-4 ring-transparent hover:bg-gray-800 focus:bg-gray-500 disabled:opacity-60;
  }
  :global(.pedro-button.btn-primary-outline) {
    @apply border border-gray-900 text-gray-900 hover:bg-gray-900/15 focus:border-transparent focus:bg-transparent;
  }
  :global(.pedro-button.btn-secondary) {
    @apply bg-white text-gray-900 hover:bg-gray-200 focus:bg-gray-500 disabled:opacity-60;
  }
  :global(.pedro-button.btn-reverse) {
    @apply flex-row-reverse;
  }
</style>
