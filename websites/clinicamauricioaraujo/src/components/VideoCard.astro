---
import { cn } from "@utils"
import type { HTMLAttributes } from "astro/types"

type Props = HTMLAttributes<"article"> & {
  author: string
  context: string
  videoId: string
  embedUrl: string
}

const {
  author,
  context,
  videoId,
  embedUrl,
  class: className,
  ...props
} = Astro.props
---

<article class:list={cn("w-full", className)} data-video-card {...props}>
  <button
    type="button"
    class="focus-visible:ring-brand-300 group relative block w-full cursor-pointer overflow-hidden rounded-3xl bg-neutral-950 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset"
    data-video-play
    data-embed={embedUrl}
    aria-label={`Reproduzir depoimento de ${author}`}
  >
    <img
      src={`https://img.youtube.com/vi/${videoId}/hqdefault.jpg`}
      srcset={`https://img.youtube.com/vi/${videoId}/mqdefault.jpg 320w, https://img.youtube.com/vi/${videoId}/hqdefault.jpg 480w, https://img.youtube.com/vi/${videoId}/maxresdefault.jpg 1280w`}
      sizes="(max-width: 640px) 320px, (max-width: 1024px) 480px, 1280px"
      alt={`Miniatura do depoimento de ${author}`}
      class="opacity-92 aspect-video w-full object-cover"
      loading="lazy"
    />
    <div
      class="bg-linear-to-t absolute inset-0 from-neutral-950 via-neutral-950/30 to-transparent"
    >
    </div>
    <div
      class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-5 sm:p-6"
    >
      <div class="max-w-[75%]">
        <p
          class="text-brand-100 inline-flex w-fit rounded-full bg-neutral-950/70 px-3 py-2 text-xs font-semibold uppercase tracking-widest backdrop-blur-sm"
        >
          {author}
        </p>
        <p class="text-white/76 mt-2 text-sm leading-6">{context}</p>
      </div>
      <div
        class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white text-neutral-950 transition-transform group-hover:scale-105"
      >
        <span aria-hidden="true" class="ml-1 text-lg">▶</span>
      </div>
    </div>
  </button>
</article>

<script>
  document.querySelectorAll("[data-video-card]").forEach(card => {
    const playButton = card.querySelector("[data-video-play]")
    if (!(playButton instanceof HTMLButtonElement)) {
      return
    }

    playButton.addEventListener("click", () => {
      const iframe = document.createElement("iframe")
      iframe.src = playButton.dataset.embed || ""
      iframe.className = "aspect-video w-full"
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      iframe.allowFullscreen = true
      iframe.referrerPolicy = "strict-origin-when-cross-origin"

      const wrapper = document.createElement("div")
      wrapper.className = "overflow-hidden rounded-3xl bg-neutral-950"
      wrapper.appendChild(iframe)

      card.replaceChildren(wrapper)
    })
  })
</script>
