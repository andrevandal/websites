---
import { cn } from "@utils"
import type { HTMLTag, Polymorphic } from "astro/types"

type Tag = keyof HTMLElementTagNameMap

type Props<T extends HTMLTag = "span"> = Polymorphic<{ as: T }> & {
  variant?: "light" | "dark"
  class?: string
  pill?: boolean
}

const {
  as: Tag = "span",
  variant = "light",
  class: className,
  pill,
  ...props
} = Astro.props
---

<Tag
  class:list={cn([
    "text-[0.72rem] font-semibold uppercase tracking-[0.28em]",
    variant === "dark" ? "text-brand-200" : "text-brand-700",
    pill && "rounded-full bg-white/95 px-2 py-1",
    className,
  ])}
  {...props}
>
  <slot />
</Tag>
