---
import { SunPicture } from "@vandal-websites/sun-ui/astro"
import { getImageSource, cn } from "#/utils"

type Props = {
  src: string
  alt?: string
  width?: number
  height?: number
  class?: string
}

const {
  src,
  alt = "",
  width = 1280,
  height = 560,
  class: className,
} = Astro.props

const source = getImageSource(src)
---

<SunPicture
  src={source}
  alt={alt}
  width={width}
  height={height}
  sources={[
    {
      media: "(min-width: 1024px)",
      src: source,
      width: 1280,
      height: 560,
      breakpoints: [{ minWidth: 1281, width: 1920 }],
    },
    {
      media: "(min-width: 0px)",
      src: source,
      width: 430,
      height: 269,
      breakpoints: [{ minWidth: 431, width: 768 }],
    },
  ]}
  densities={[1]}
  fit="cover"
  placeholder={false}
  loading="eager"
  fetchpriority="high"
  wrapperClass={cn("z-0 block w-full h-full", className)}
  class={cn("h-full w-full object-cover", className)}
/>
