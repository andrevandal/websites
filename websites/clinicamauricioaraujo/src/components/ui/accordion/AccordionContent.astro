---
/**
 * NOTE: style="animation: none;" makes it so the close animation doesn't run on page load
 * It is later removed in the Accordion.astro script
 */
import type { HTMLAttributes } from "astro/types"
import { cn } from "@utils"

type Props = HTMLAttributes<"div"> & { innerClass?: string }

const { class: className, innerClass, ...rest } = Astro.props
---

<div
  class={cn(
    "accordion-content",
    "transform-gpu overflow-hidden",
    "data-[state=closed]:animate-accordion-up data-[state=closed]:h-0",
    "data-[state=open]:animate-accordion-down",
    className
  )}
  data-state="closed"
  style="animation: none;"
  {...rest}
  data-slot="accordion-content"
>
  <div class={cn("pt-0 pb-4", innerClass)}>
    <slot />
  </div>
</div>
