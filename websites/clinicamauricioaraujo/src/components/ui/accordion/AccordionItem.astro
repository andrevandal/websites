---
import type { HTMLAttributes } from "astro/types"
import { cn } from "@utils"

type Props = HTMLAttributes<"div">

const { class: className, ...rest } = Astro.props
---

<div
  class={cn("accordion-item", className)}
  data-state="closed"
  {...rest}
  data-slot="accordion-item"
>
  <slot />
</div>
