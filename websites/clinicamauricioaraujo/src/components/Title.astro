---
import { cn } from "@utils"
import type { HTMLTag, Polymorphic } from "astro/types"

type Props<T extends HTMLTag = "span"> = Polymorphic<{ as: T }> & {
  size?: "small" | "medium" | "large"
}

const {
  as: Tag = "span",
  class: className,
  size = "medium",
  ...props
} = Astro.props
---

<Tag
  class:list={cn(
    {
      "max-w-3xl text-5xl font-semibold leading-none tracking-tighter sm:text-6xl":
        size === "large",
      "max-w-2xl text-4xl font-semibold leading-none tracking-tight sm:text-5xl":
        size === "medium",
      "max-w-xl text-3xl font-semibold leading-snug tracking-normal sm:text-4xl":
        size === "small",
    },
    className
  )}
  {...props}
>
  <slot />
</Tag>
