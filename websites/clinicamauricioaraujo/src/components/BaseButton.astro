---
import type { Polymorphic } from "astro/types"
import { SunButton } from "@vandal-websites/sun-ui/astro"

import { cn } from "#/utils"

type Sizes = "small" | "medium" | "large"

type CustomProps = {
  variant?:
    | "primary"
    | "primary-outline"
    | "secondary"
    | "secondary-outline"
    | "white-outline"
    | "brand"
    | "brand-outline"
  reverse?: boolean
  block?: boolean
  centered?: boolean
  size?: Sizes
  increaseSize?: boolean
}

type Props<T extends "a" | "button"> = Polymorphic<{ as: T }> & CustomProps

const {
  as: Tag = "button",
  class: className,
  href,
  variant,
  reverse,
  size = "base",
  block = false,
  centered = false,
  increaseSize,
  ...props
} = Astro.props
---

<SunButton
  as={Tag}
  href={href?.toString()}
  block={block}
  centered={centered}
  className={cn(
    "clinic-button btn",
    {
      "btn-primary": variant === "primary",
      "btn-primary-outline": variant === "primary-outline",
      "btn-secondary": variant === "secondary",
      "btn-secondary-outline": variant === "secondary-outline",
      "btn-white-outline": variant === "white-outline",
      "btn-brand": variant === "brand",
      "btn-brand-outline": variant === "brand-outline",
      "btn-reverse": reverse,
      "btn-small": size === "small",
      "btn-medium": size === "medium",
      "btn-large": size === "large",
      "btn-increased": increaseSize,
    },
    className
  )}
  {...props}
>
  <slot />
  <slot name="icon" slot="suffix" />
</SunButton>

<style>
  @reference "../styles/global.css";

  :global(.clinic-button.btn) {
    @apply gap-x-2 rounded-full px-6 py-4 text-base font-semibold whitespace-nowrap transition-all duration-200 ease-out;
  }
  :global(.clinic-button.btn-large) {
    @apply h-14 px-6 py-4;
  }
  :global(.clinic-button.btn-medium) {
    @apply h-12 px-3 py-3;
    &:global(.btn-increased) {
      @apply lg:h-14 lg:px-6 lg:py-4;
    }
  }
  :global(.clinic-button.btn-small) {
    @apply h-10 px-6 py-2;
  }
  :global(.clinic-button.btn-primary) {
    @apply bg-brand-950 text-brand-50 hover:bg-brand-800 focus:bg-brand-700 ring-4 ring-transparent disabled:opacity-60;
  }
  :global(.clinic-button.btn-primary-outline) {
    @apply border-brand-950 text-brand-950 hover:bg-brand-950/15 border focus:border-transparent focus:bg-transparent;
  }
  :global(.clinic-button.btn-secondary) {
    @apply text-brand-950 hover:bg-brand-200 focus:bg-brand-600 bg-white disabled:opacity-60;
  }
  :global(.clinic-button.btn-secondary-outline) {
    @apply border-brand-950 text-brand-950 hover:bg-brand-950/15 border focus:border-transparent focus:bg-transparent;
  }
  :global(.clinic-button.btn-white-outline) {
    @apply border border-white text-white hover:bg-white/15 focus:border-transparent focus:bg-transparent;
  }
  :global(.clinic-button.btn-brand) {
    @apply bg-brand-500 hover:bg-brand-600 focus:bg-brand-700 text-white disabled:opacity-60;
  }
  :global(.clinic-button.btn-brand-outline) {
    @apply border-brand-300 border text-white hover:bg-white/15 focus:border-transparent focus:bg-transparent;
  }
  :global(.clinic-button.btn.btn-reverse) {
    @apply flex-row-reverse;
  }
</style>
