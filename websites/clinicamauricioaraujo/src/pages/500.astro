---
import BaseLayout from "../layouts/Base.astro"
import Eyebrow from "../components/Eyebrow.astro"
import { siteConfig } from "../data/site"
import type { ComponentProps } from "astro/types"
import BaseSection from "@components/BaseSection.astro"
import Title from "@components/Title.astro"
import Description from "@components/Description.astro"
import BaseButton from "@components/BaseButton.astro"

const meta = {
  title: `Erro interno | Clínica Maurício Araújo`,
  description:
    "Ocorreu um erro inesperado no servidor. Tente novamente em instantes ou entre em contato com a clínica.",
  image: siteConfig.defaultSocialImage,
  url: Astro.url,
  footerLess: true,
} satisfies ComponentProps<typeof BaseLayout>
---

<BaseLayout {...meta}>
  <BaseSection
    class="bg-brand-950 grid min-h-[calc(100vh-4.5rem)] py-0"
    containerClass="py-16 self-center"
    contentClass="h-full flex flex-col text-center justify-center gap-4"
  >
    <Eyebrow class="text-white/90">Erro 500</Eyebrow>
    <Title class="text-brand-300/90 mx-auto max-w-none" size="large"
      >Algo deu errado no servidor</Title
    >
    <Description class="mx-auto text-white/90">
      Ocorreu um erro inesperado. Tente recarregar a página em alguns instantes
      ou entre em contato com a clínica caso o problema persista.
    </Description>
    <div class="mx-auto mt-4">
      <BaseButton as="a" href="/" variant="brand">Voltar ao Ínicio</BaseButton>
    </div>
  </BaseSection>
</BaseLayout>
