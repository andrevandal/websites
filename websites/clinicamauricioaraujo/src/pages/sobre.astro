---
import BaseSection from "../components/BaseSection.astro"
import TeamCard from "../components/TeamCard.astro"
import BaseLayout from "../layouts/Base.astro"
import { doctorProfile, teamMembers } from "../data/team"
import { siteConfig } from "../data/site"
import type { ComponentProps } from "astro/types"
import BaseButton from "@components/BaseButton.astro"
import Cover from "@components/Cover.astro"
import Description from "@components/Description.astro"
import TheHero from "@components/TheHero.astro"
import Title from "@components/Title.astro"
import Eyebrow from "@components/Eyebrow.astro"
import { getImageUrl } from "@utils"

const meta = {
  title: `Sobre - Clínica Maurício Araújo`,
  description:
    "Conheça a Clínica Maurício Araújo, a trajetória do Dr. Maurício Araújo e a equipe de especialistas que atua de forma integrada.",
  url: Astro.url,
} satisfies ComponentProps<typeof BaseLayout>
---

<BaseLayout {...meta}>
  <TheHero slot="header">
    <Title
      slot="title"
      size="large"
      as="h1"
      class="animate-hero text-balance [animation-delay:100ms]"
    >
      A clínica, o Dr. Maurício Araújo e a equipe
    </Title>
    <Description
      slot="description"
      class="animate-hero [animation-delay:250ms]"
    >
      Uma leitura institucional sobre a clínica, a trajetória do Dr. Maurício e
      a forma como a equipe atua de maneira integrada
    </Description>
    <div
      slot="actions"
      class="animate-hero flex flex-col gap-2 [animation-delay:400ms]"
    >
      <BaseButton as="a" variant="brand" href="#dr-mauricio" class="px-6">
        Conheça o Dr. Maurício
      </BaseButton>
      <BaseButton
        as="a"
        variant="white-outline"
        href="#equipe"
        class="border border-neutral-300"
      >
        Conheça a equipe
      </BaseButton>
    </div>
    <Cover
      slot="cover"
      src="images/clinica.jpg"
      alt="Foto da Clinica Maurício Araújo"
    />
  </TheHero>

  <BaseSection id="clinica">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
      <div class="space-y-4 text-lg leading-8 text-neutral-600" data-animate>
        <Eyebrow class="text-brand-700 uppercase">Clínica</Eyebrow>
        <Title size="medium" class="text-neutral-950" as="h2">
          Uma prática construída para unir ciência, cuidado e previsibilidade
        </Title>
        <p>
          Localizada na Barra da Tijuca, a clínica combina experiência clínica,
          odontologia digital, equipe multiprofissional e atendimento acolhedor
          em português e inglês. A proposta é entregar qualidade técnica sem
          transformar o paciente em mais um caso padronizado.
        </p>
        <p>
          A estrutura também favorece acompanhamento longitudinal, o que melhora
          diagnóstico, manutenção e comunicação entre cirurgia, periodontia,
          prótese, ortodontia, endodontia e reabilitação.
        </p>
      </div>
      <div class="grid gap-6 lg:grid-cols-1">
        <div
          class="border-neutral-950 lg:border-l lg:pl-5"
          data-animate
          data-delay="1"
        >
          <p
            class="text-brand-700 text-xs font-semibold tracking-widest uppercase"
          >
            Base científica
          </p>
          <h3
            class="mt-4 text-3xl leading-tight font-semibold tracking-tight text-neutral-950"
          >
            Decisão clínica com critério
          </h3>
          <p class="mt-3 text-sm leading-7 text-neutral-600">
            Diagnóstico, indicação real e atualização constante sustentam a
            tomada de decisão da equipe.
          </p>
        </div>
        <div
          class="border-neutral-950 lg:border-l lg:pl-5"
          data-animate
          data-delay="2"
        >
          <p
            class="text-brand-700 text-xs font-semibold tracking-widest uppercase"
          >
            Experiência
          </p>
          <h3
            class="mt-4 text-3xl leading-tight font-semibold tracking-tight text-neutral-950"
          >
            Atendimento claro e humano
          </h3>
          <p class="mt-3 text-sm leading-7 text-neutral-600">
            A clínica busca explicar com clareza, reduzir ansiedade e orientar o
            paciente em cada etapa.
          </p>
        </div>
        <div
          class="border-neutral-950 lg:border-l lg:pl-5"
          data-animate
          data-delay="3"
        >
          <p
            class="text-brand-700 text-xs font-semibold tracking-widest uppercase"
          >
            Integração
          </p>
          <h3
            class="mt-4 text-3xl leading-tight font-semibold tracking-tight text-neutral-950"
          >
            Especialidades que conversam
          </h3>
          <p class="mt-3 text-sm leading-7 text-neutral-600">
            O tratamento fica mais previsível quando equipe, planejamento e
            manutenção funcionam em conjunto.
          </p>
        </div>
      </div>
    </div>
  </BaseSection>

  <BaseSection id="dr-mauricio" background="dark">
    <div class="flex flex-col gap-4" data-animate>
      <Eyebrow class="text-brand-200 mx-auto text-center text-balance"
        >Dr. Maurício Araújo</Eyebrow
      >
      <p
        class="mx-auto text-center text-xs tracking-widest text-white/50 uppercase"
      >
        {siteConfig.cro}
      </p>
      <Title
        size="medium"
        class="mx-auto max-w-none text-center text-balance text-white"
        as="h2"
      >
        O nome da clínica também carrega responsabilidade técnica
      </Title>
    </div>
    <div class="grid gap-10 py-12 lg:grid-cols-[0.90fr_1.10fr] lg:items-start">
      <div
        class="overflow-hidden rounded-3xl bg-neutral-950 lg:sticky lg:top-18"
        data-animate
        data-delay="1"
      >
        <img
          src={getImageUrl("/images/mauricio.png", "w_1280,h_560,mode_crop")}
          alt="Retrato do Dr. Maurício Araújo"
          class="aspect-[4/4.7] w-full object-cover"
          loading="lazy"
        />
      </div>
      <div
        class="space-y-4 text-lg leading-8 text-white/78"
        data-animate
        data-delay="2"
      >
        {doctorProfile.intro.map(paragraph => <p>{paragraph}</p>)}
        <p
          class="text-brand-200 text-xs font-semibold tracking-widest uppercase"
        >
          Destaques
        </p>
        <ul class="mt-4 space-y-3 text-sm leading-7 text-white/76">
          {doctorProfile.highlights.map(item => <li>• {item}</li>)}
        </ul>
        <p
          class="text-brand-200 text-xs font-semibold tracking-widest uppercase"
        >
          Trajetória acadêmica e profissional
        </p>
        <ul class="mt-4 space-y-3 text-sm leading-7 text-white/76">
          {doctorProfile.trajectory.map(item => <li>• {item}</li>)}
        </ul>
      </div>
    </div>

    <div class="grid gap-8 py-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div class="space-y-5 text-lg leading-8 text-white/78" data-animate>
        <div class="flex flex-col gap-2">
          <Eyebrow class="text-brand-200 text-balance">Atuação</Eyebrow>
          <Title size="small" class="text-balance text-white" as="h3">
            Reconhecimento internacional sem perder a lógica de atendimento
            próximo
          </Title>
          <Description class="text-balance text-white/78">
            A autoridade científica do Dr. Maurício só faz sentido porque se
            traduz em planejamento mais qualificado, decisões mais seguras e
            maior previsibilidade clínica no dia a dia.
          </Description>
        </div>
        {
          doctorProfile.clinic.map(paragraph => (
            <Description class="text-balance text-white/78">
              {paragraph}
            </Description>
          ))
        }
      </div>
      <div
        class="overflow-hidden rounded-3xl bg-neutral-950 lg:sticky lg:top-20"
        data-animate
        data-delay="1"
      >
        <img
          src={getImageUrl("/images/dr1.png", "w_1280,h_560,mode_crop")}
          alt="Dr. Maurício em discursando em simpósio de osteologia em Barcelona em 2019"
          class="aspect-[4/4.7] w-full object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </BaseSection>

  <BaseSection id="equipe">
    <header class="flex flex-col gap-2" data-animate>
      <Eyebrow class="text-brand-500 mx-auto text-center text-balance"
        >Equipe</Eyebrow
      >
      <Title
        size="medium"
        class="text-brand-800 mx-auto text-center text-balance"
        as="h2"
      >
        Cinco profissionais com atuação complementar
      </Title>
      <Description
        class="mx-auto mt-2 text-center text-balance text-neutral-700"
      >
        A equipe reúne áreas estratégicas para diagnóstico, cirurgia,
        reabilitação e manutenção com visão integrada.
      </Description>
    </header>
    <div class="mt-12 grid gap-8 lg:grid-cols-2 xl:grid-cols-3">
      {
        teamMembers.map((member, index) => (
          <TeamCard
            member={member}
            data-animate=""
            data-delay={String((index % 3) + 1)}
          />
        ))
      }
    </div>
  </BaseSection>

  <BaseSection
    slot="footer"
    class="bg-brand-600 py-0 text-white sm:py-0 lg:py-0"
    containerClass="px-8 py-10 lg:px-12"
    contentClass="gap-4 lg:mx-auto"
  >
    <Title
      class="text-balance text-white lg:max-w-none"
      size="small"
      data-animate
    >
      Conhecimento sólido só faz sentido quando melhora a experiência do
      paciente
    </Title>
    <Description
      class="text-white/84 lg:max-w-none"
      data-animate
      data-delay="1"
    >
      Se você quer entender melhor a clínica e já dar o próximo passo, o canal
      mais direto é o WhatsApp.
    </Description>
    <BaseButton
      as="a"
      href={siteConfig.whatsAppLink}
      variant="primary"
      class="track-conversion"
      data-lead-type="whatsapp"
      data-button-location="body"
      data-animate
      data-delay="2"
    >
      Fale conosco
    </BaseButton>
  </BaseSection>
</BaseLayout>
