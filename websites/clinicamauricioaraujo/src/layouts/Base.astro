---
import "../styles/global.css"

import { Font } from "astro:assets"

import TheHeader from "@components/TheHeader.astro"
import TheFooter from "@components/TheFooter.astro"
import Gtag from "@components/Gtag.astro"
import AnimateOnScroll from "@components/AnimateOnScroll.astro"
import { getImageUrl } from "@utils"
import { siteConfig } from "@/data/site"

import {
  PUBLIC_GOOGLE_ANALYTICS_ID as googleAnalyticsId,
  PUBLIC_GOOGLE_ADS_CONVERSION_ID as conversionId,
  PUBLIC_GOOGLE_ADS_CONVERSION_LABEL as conversionLabel,
} from "astro:env/client"
import type { HTMLAttributes } from "astro/types"

type Props = {
  title: string
  description?: string
  image?: string
  url: URL
  schema?: Record<string, unknown>
  links?: HTMLAttributes<"link">[]
  footerLess?: boolean
}

const {
  title,
  description = siteConfig.defaultSocialImage,
  schema,
  links,
  url,
  footerLess,
} = Astro.props
const domain = url.hostname

const chooseSocialImagem = (image?: string) => {
  if (!image || !image.length) {
    return ""
  }
  if (/^(?<protocol>https?:)?\/\//.test(image)) {
    return image
  }
  return getImageUrl(
    image.startsWith("/") ? image : `/${image}`,
    "f_auto,q_90,w_1200,h_630"
  )
}

const image = chooseSocialImagem(
  Astro.props.image ?? siteConfig.defaultSocialImage
)
---

<html class="scroll-p-20.5 h-full scroll-smooth" lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content="#152329" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="canonical" href={url} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {links?.map(link => <link {...link} />)}
    <meta name="description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="twitter:domain" content={domain} />
    <meta property="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <Gtag
      placement="head"
      googleAnalyticsId={googleAnalyticsId}
      conversionId={conversionId}
      conversionLabel={conversionLabel}
    />
    <Font cssVariable="--font-inter" preload />
  </head>
  <body class="h-full">
    <TheHeader>
      <slot name="header" slot="default">
        <div class="h-18 w-full bg-gray-900"></div>
      </slot>
    </TheHeader>
    <slot />
    {
      !footerLess && (
        <TheFooter>
          <slot name="footer" />
        </TheFooter>
      )
    }
    <AnimateOnScroll />
    {
      schema && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(schema)}
        />
      )
    }
    <Gtag
      placement="body"
      googleAnalyticsId={googleAnalyticsId}
      conversionId={conversionId}
      conversionLabel={conversionLabel}
    />
  </body>
</html>
