---
import "../styles/global.css"

import { Font } from "astro:assets"
import type { HTMLAttributes } from "astro/types"

import {
  SunAnimateOnScroll as AnimateOnScroll,
  SunLayout as Layout,
} from "@vandal-websites/sun-ui/astro"
import TheHeader from "@components/TheHeader.astro"
import TheFooter from "@components/TheFooter.astro"
import { getImageUrl } from "@utils"
import { siteConfig } from "@/data/site"

type Props = {
  title: string
  description?: string
  image?: string
  url: URL
  schema?: Record<string, unknown>
  links?: HTMLAttributes<"link">[]
  footerLess?: boolean
}

const {
  title,
  description = siteConfig.defaultSocialImage,
  schema,
  links,
  url,
  footerLess,
} = Astro.props

const processImage = (image?: string) => {
  if (!image || !image.length) return ""
  if (/^(?<protocol>https?:)?\/\//.test(image)) return image
  return getImageUrl(
    image.startsWith("/") ? image : `/${image}`,
    "f_auto,q_90,w_1200,h_630"
  )
}

const image = processImage(Astro.props.image ?? siteConfig.defaultSocialImage)
---

<Layout
  title={title}
  description={description}
  image={image}
  url={url}
  schema={schema}
  links={links}
  themeColor="#152329"
  class="scroll-p-20.5"
>
  <Font cssVariable="--font-inter" preload slot="close-head" />
  <TheHeader>
    <slot name="header" slot="default">
      <div class="h-18 w-full bg-gray-900"></div>
    </slot>
  </TheHeader>
  <slot />
  {
    !footerLess && (
      <TheFooter>
        <slot name="footer" />
      </TheFooter>
    )
  }
  <AnimateOnScroll slot="close-body" />
</Layout>
