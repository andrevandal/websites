---
import { waLink } from "@vandal-websites/sun-ui"
import { SunButton, SunIcon } from "@vandal-websites/sun-ui/astro"
import type { Dict } from "@lib/i18n"
import { WA_NUMBER } from "#/lib/whatsapp"

type Props = {
  dict: Dict
}

const { dict } = Astro.props
---

<SunButton
  as="a"
  href={waLink(WA_NUMBER, dict.wa_general)}
  target="_blank"
  className="lb-cta border-ink-900 bg-signal text-ink-900 hover:bg-signal-300 mt-8 gap-4 border-[1.5px] px-6 py-4.5 shadow-[4px_4px_0_var(--color-ink-900)] duration-180 ease-out *:inline-flex *:items-center *:justify-center *:gap-2 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[6px_6px_0_var(--color-ink-900)] active:translate-x-px active:translate-y-px active:shadow-[2px_2px_0_var(--color-ink-900)]"
  style="border-radius: var(--radius-r1)"
>
  <SunIcon
    name="whatsapp"
    slot="prefix"
    width={24}
    height={24}
    role="img"
    aria-label="WhatsApp"
  />
  <span class="flex-1 font-sans text-base font-bold tracking-[-0.01em]"
    >{dict.cta_primary}</span
  >
  <SunIcon
    name="arrow-right"
    slot="suffix"
    class="lb-arrow"
    width={18}
    height={18}
    aria-hidden="true"
  />
</SunButton>

<style>
  @reference "tailwindcss";

  .lb-arrow {
    @apply opacity-0 duration-180 ease-out;
    transform: translateX(-8px);
    transition-property: opacity, transform;
  }

  .lb-cta:hover .lb-arrow,
  .lb-cta:focus-visible .lb-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .lb-arrow {
      transform: none;
      transition-property: opacity;
    }

    .lb-cta:hover .lb-arrow,
    .lb-cta:focus-visible .lb-arrow {
      transform: none;
    }
  }
</style>
