---
type Props = {
  id: string
  accent?: string
  distort?: boolean
  label?: string
}

const {
  id,
  accent = "var(--color-signal)",
  distort = false,
  label,
} = Astro.props

const maskId = `sever-${id}`
const filterId = `spray-${id}`

const a11y = label
  ? ({ role: "img", "aria-label": label } as const)
  : ({ "aria-hidden": "true" } as const)
---

<svg
  viewBox="0 0 100 100"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class="brand-mark text-ink-900 block h-full w-full"
  {...a11y}
>
  <defs>
    {
      distort && (
        <filter id={filterId} x="-25%" y="-25%" width="150%" height="150%">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.6 0.82"
            numOctaves="2"
            seed="7"
            result="n"
          />
          <feDisplacementMap
            in="SourceGraphic"
            in2="n"
            scale="3.3"
            xChannelSelector="R"
            yChannelSelector="G"
          />
        </filter>
      )
    }
    <mask id={maskId}>
      <rect x="0" y="0" width="100" height="100" fill="#fff"></rect>
      <path d="M2 92 L98 8" stroke="#000" stroke-width="21"></path>
    </mask>
  </defs>
  <rect
    x="11"
    y="11"
    width="78"
    height="78"
    stroke="currentColor"
    stroke-width="7"
    mask={`url(#${maskId})`}></rect>
  {
    distort ? (
      <g filter={`url(#${filterId})`}>
        <path
          d="M2 92 L98 8"
          stroke={accent}
          stroke-width="13"
          stroke-linecap="butt"
        />
      </g>
    ) : (
      <path d="M2 92 L98 8" stroke={accent} stroke-width="13" />
    )
  }
</svg>
