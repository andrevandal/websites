---
import { waLink } from "@vandal-websites/sun-ui"
import { SunIcon } from "@vandal-websites/sun-ui/astro"
import type { Dict } from "@lib/i18n"
import { WA_NUMBER } from "#/lib/whatsapp"

type Props = {
  dict: Dict
}

const { dict } = Astro.props

const modes = [
  {
    n: "01",
    title: dict.mode1_t,
    desc: dict.mode1_d,
    message: dict.wa_consulting,
  },
  {
    n: "02",
    title: dict.mode2_t,
    desc: dict.mode2_d,
    message: dict.wa_training,
  },
  {
    n: "03",
    title: dict.mode3_t,
    desc: dict.mode3_d,
    message: dict.wa_impl,
  },
]
---

<section class="mt-12">
  <div class="flex flex-col gap-3">
    {
      modes.map(mode => (
        <a
          href={waLink(WA_NUMBER, mode.message)}
          target="_blank"
          rel="noopener noreferrer"
          class="group border-line bg-paper-raise hover:border-ink-900 grid grid-cols-[auto_1fr_auto] items-start gap-4 border p-5 text-inherit no-underline duration-[180ms] ease-out hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[4px_4px_0_var(--color-ink-900)]"
          style="border-radius: var(--radius-r1)"
        >
          <span class="text-graphite-200 pt-[3px] font-mono text-[11px] tracking-[0.08em]">
            {mode.n}
          </span>
          <span class="flex flex-col gap-1">
            <span class="text-ink-900 font-sans text-lg font-bold tracking-[-0.015em]">
              {mode.title}
            </span>
            <span class="text-graphite-300 font-mono text-[11px] leading-normal tracking-[0.01em]">
              {mode.desc}
            </span>
          </span>
          <span class="text-graphite-300 group-hover:text-ink-900 pt-[3px] duration-[180ms] ease-out group-hover:translate-x-0.5">
            <SunIcon
              name="arrow-right"
              width={15}
              height={15}
              aria-hidden="true"
            />
          </span>
        </a>
      ))
    }
  </div>
</section>
