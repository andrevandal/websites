---
import "@/styles/global.css"
import { SunLayout, assetUrl } from "@vandal-websites/sun-ui/astro"
import { Font } from "astro:assets"
import { getSecret, S3_PUBLIC_URL } from "astro:env/server"
import type { Lang } from "@lib/i18n"

type Props = {
  lang: Lang
  title: string
  description?: string
  url: URL
  image?: string
}

const {
  lang,
  title,
  description,
  url,
  image = assetUrl(getSecret, "og-image.png", S3_PUBLIC_URL),
} = Astro.props
const htmlLang = lang === "pt" ? "pt-BR" : "en"
const links = [
  { rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },
  { rel: "alternate", hreflang: "en", href: new URL("/en/", url).toString() },
  {
    rel: "alternate",
    hreflang: "pt-BR",
    href: new URL("/pt/", url).toString(),
  },
  {
    rel: "alternate",
    hreflang: "x-default",
    href: new URL("/", url).toString(),
  },
]
---

<SunLayout
  lang={htmlLang}
  title={title}
  description={description}
  url={url}
  image={new URL(image, url).toString()}
  links={links}
>
  <Fragment slot="close-head">
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-archivo-expanded" preload />
    <Font cssVariable="--font-newsreader" preload />
    <Font cssVariable="--font-jetbrains-mono" preload />
  </Fragment>
  <slot />
</SunLayout>
