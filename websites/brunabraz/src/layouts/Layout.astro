---
import "@styles/global.css"

import { SunLayout, SunAnimateOnScroll } from "@vandal-websites/sun-ui/astro"
import { getSiteSettings } from "emdash"
import { loadAnalyticsSettings } from "@vandal-websites/emdash-plugin-analytics/settings"
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui"
import { createPublicPageContext } from "emdash/page"
import TheFooter from "@/components/TheFooter.astro"

import { Font } from "astro:assets"
import type { ComponentProps } from "astro/types"

type Props = ComponentProps<typeof SunLayout> & {
  content?: { collection: string; id: string; slug?: string | null }
}

const { content, image, ...rest } = Astro.props

// EmDashHead renders the SEO tags; it falls back to the default social image
// from site settings. Title and description fall back to the site title and
// tagline, so no page renders empty share metadata.
const site = await getSiteSettings()
const props = {
  ...rest,
  title: rest.title || site.title || "",
  description: rest.description || site.tagline || "",
}

// Tracking IDs are edited in the admin's Analytics page (plugin "analytics").
const gtag = {
  ...(await loadAnalyticsSettings()),
}

const page = createPublicPageContext({
  Astro,
  kind: content ? "content" : "custom",
  pageType: "website",
  title: props.title,
  description: props.description,
  canonical: String(props.url),
  image,
  content,
})
---

<SunLayout lang="pt-BR" class="no-js" gtag={gtag} seoTags={false} {...props}>
  <Fragment slot="close-head">
    <script is:inline>
      document.documentElement.classList.replace("no-js", "js")
    </script>
    <Font cssVariable="--font-dm-sans" preload />
    <Font cssVariable="--font-averia" preload />
    <EmDashHead page={page} />
    <slot name="head" />
  </Fragment>
  <EmDashBodyStart page={page} slot="open-body" />
  <div class="flex min-h-screen flex-col [&>main]:grow">
    <slot />
    <TheFooter />
  </div>
  <Fragment slot="close-body">
    <SunAnimateOnScroll />
    <EmDashBodyEnd page={page} />
  </Fragment>
</SunLayout>
