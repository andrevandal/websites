---
import type { PageLayoutCredentialsBlock } from "../../../emdash-env"

type Props = { value: PageLayoutCredentialsBlock }

const { value } = Astro.props
---

<section
  id={value.anchor || "credenciais"}
  class="bg-ruddy-brown border-t-tobago border-b-ruddy-brown border-t border-b"
>
  <ul
    class="text-white-chocolate text-stat divide-tobago flex flex-col items-center divide-y px-0 tracking-[-.48px] sm:grid sm:grid-cols-2 sm:flex-row sm:items-stretch sm:justify-center sm:divide-x sm:divide-y-0 lg:mx-auto lg:max-w-240 lg:grid-cols-4 lg:px-8 xl:max-w-304"
  >
    {
      value.items?.map(({ text }, index) => (
        <li
          class="sm:border-b-tobago flex w-full items-center justify-center px-2 py-2 text-center sm:border-b lg:border-b-0"
          data-animate
          data-delay={index + 1}
        >
          {text.split("\n").map((line, lineIndex) => (
            <Fragment>
              {lineIndex > 0 && <br />}
              {line}
            </Fragment>
          ))}
        </li>
      ))
    }
  </ul>
</section>
