---
import { SunPicture } from "@vandal-websites/sun-ui/astro"
import { SunCarousel } from "@vandal-websites/sun-ui/svelte"
import Heading from "@components/Heading.astro"

import type { Testimonial } from "@/types"

type Props = {
  testimonials: Testimonial[]
  title?: string
  description?: string
  id?: string
}

const {
  testimonials,
  title = "Depoimentos",
  description = "Veja os depoimentos dos meus alunos",
  id,
} = Astro.props
---

<section
  id={id}
  class="flex flex-col overflow-clip bg-white px-0 pt-14 pb-18 sm:pb-14"
>
  <div
    class="container mb-8 flex min-h-0 flex-col gap-y-6 sm:min-h-[103px]"
    data-animate
  >
    <Heading as="h2" class="text-tobago text-section-heading text-center">
      {title}
    </Heading>
    <p class="text-brown-leather text-body-small text-center">
      {description}
    </p>
  </div>
  <div data-animate>
    <SunCarousel
      client:load
      className="items-stretch"
      direction="left-to-right"
    >
      {
        testimonials.map(({ image, author, role, content }) => {
          return (
            <article class="bg-white-chocolate/25 border-tobago/15 flex w-[286px] shrink-0 snap-center flex-col items-start border p-6 first:ml-4 last:mr-4 first:lg:ml-8 last:lg:mr-8">
              <div class="flex w-full flex-1 flex-col items-start">
                <span class="text-light-mushroom font-serif text-[2rem] leading-normal font-bold select-none">
                  &ldquo;
                </span>
                <blockquote class="text-brown-leather text-testimonial mt-1 text-balance italic select-none">
                  {content}
                </blockquote>
              </div>
              <div class="border-b-tobago/15 my-4 w-full border-b" />
              <div class="mt-auto flex w-full flex-row items-center-safe justify-items-start gap-x-4">
                <SunPicture
                  src={image.src}
                  alt={image.alt}
                  width={40}
                  height={40}
                  quality={90}
                  densities={[1, 1.5, 1.75, 2, 3]}
                  wrapperClass="border-tobago/10 pointer-events-none size-10 shrink-0 overflow-hidden rounded-full border"
                  class="size-full object-cover"
                />
                <div class="flex min-w-0 flex-col">
                  <Heading
                    as="h3"
                    class="text-tobago text-[.875rem] leading-[110%] font-semibold select-none"
                  >
                    {author}
                  </Heading>
                  <p class="text-tobago/50 mt-1 text-[.875rem] leading-[110%] select-none">
                    {role}
                  </p>
                </div>
              </div>
            </article>
          )
        })
      }
    </SunCarousel>
  </div>
</section>
