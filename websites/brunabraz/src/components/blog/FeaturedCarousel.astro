---
import { SunIcon, SunPicture } from "@vandal-websites/sun-ui/astro"
import Heading from "@components/Heading.astro"
import { mediaSource } from "@vandal-websites/sun-ui-emdash"
import { postExcerpt } from "@/cms/post"
import type { ContentEntry } from "emdash"
import type { Post } from "../../../emdash-env"

type Props = { posts: ContentEntry<Post>[] }

const { posts } = Astro.props
---

{
  posts.length > 0 && (
    <section
      aria-label="Destaques"
      data-carousel
      class="featured bg-white-chocolate/25"
      style={`--slides: ${posts.length}`}
    >
      <div class="featured-frame" data-carousel-frame>
        {posts.map((post, index) => (
          <a
            href={`/blog/${post.id}`}
            data-slide
            class="featured-slide group bg-cambridge lg:bg-white-chocolate/25 flex items-center"
            style={`--index: ${index}`}
          >
            <div class="absolute inset-0 lg:hidden">
              {post.data.featured_image && (
                <SunPicture
                  src={mediaSource(post.data.featured_image, Astro)}
                  alt=""
                  width={390}
                  height={780}
                  quality={85}
                  loading={index === 0 ? "eager" : "lazy"}
                  wrapperClass="size-full"
                  class="size-full object-cover"
                />
              )}
            </div>
            <div class="relative container h-full lg:flex-row lg:items-stretch lg:gap-32">
              <div class="hidden w-[492px] shrink-0 lg:block">
                {post.data.featured_image && (
                  <SunPicture
                    src={mediaSource(post.data.featured_image, Astro)}
                    alt=""
                    width={492}
                    height={820}
                    quality={85}
                    loading={index === 0 ? "eager" : "lazy"}
                    wrapperClass="size-full"
                    class="size-full object-cover"
                  />
                )}
              </div>
              <div class="my-auto flex flex-col gap-4 bg-white/85 px-4 py-6 text-center lg:w-[493px] lg:gap-6 lg:bg-transparent lg:p-0 lg:text-left">
                <Heading
                  as="h2"
                  class="text-tobago hover:link-underline-dotted group-focus-visible:link-underline-dotted font-serif text-2xl leading-[1.2] font-bold lg:text-[2.5rem]"
                >
                  {post.data.title}
                </Heading>
                <p class="text-brown-leather line-clamp-4 font-sans text-base leading-[1.29] lg:text-2xl lg:leading-[1.4]">
                  {postExcerpt(post.data)}
                </p>
                <span class="text-brown-leather hover:link-underline-dotted group-focus-visible:link-underline-dotted font-sans text-sm font-medium tracking-widest uppercase xl:w-fit">
                  Continuar lendo →
                </span>
              </div>
              <SunIcon
                name="writing-book"
                width={126}
                height={100}
                class="text-light-mushroom pointer-events-none absolute right-0 bottom-8 hidden lg:block"
                aria-hidden="true"
              />
            </div>
          </a>
        ))}
        <button
          type="button"
          data-carousel-next
          aria-label="Próximo destaque"
          class="featured-next text-brown-leather absolute bottom-6 left-1/2 -translate-x-1/2 cursor-pointer"
        >
          <SunIcon
            name="chevron-right"
            width={48}
            height={48}
            class="rotate-90"
          />
        </button>
      </div>
    </section>
  )
}

<style>
  /* Without JavaScript the slides stack, one per viewport, so every link is
     reachable. With it, the frame sticks under the nav and scroll progress
     through the section picks the active slide. */
  .featured-slide {
    position: relative;
    height: calc(100svh - 72px);
  }

  .featured-next {
    display: none;
  }

  :global(.js) .featured {
    height: calc(var(--slides) * (100svh - 72px));
  }

  :global(.js) .featured-frame {
    position: sticky;
    top: 72px;
    height: calc(100svh - 72px);
    overflow: hidden;
  }

  :global(.js) .featured-slide {
    position: absolute;
    inset: 0;
    transform: translateY(calc((var(--index) - var(--active, 0)) * 100%));
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.js) .featured-next {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .featured-slide {
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-carousel]")
  const frame = section?.querySelector<HTMLElement>("[data-carousel-frame]")

  if (section && frame) {
    const slides = [...section.querySelectorAll<HTMLElement>("[data-slide]")]
    const next = section.querySelector<HTMLButtonElement>(
      "[data-carousel-next]"
    )
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")
    const navHeight = 72
    let active = -1

    // Scroll offset at which the frame starts sticking under the nav.
    const start = () =>
      section.getBoundingClientRect().top + window.scrollY - navHeight
    const slideHeight = () => frame.getBoundingClientRect().height

    const setActive = (index: number) => {
      if (index === active) return
      active = index
      section.style.setProperty("--active", String(index))
      slides.forEach((slide, i) => {
        slide.inert = i !== index
      })
    }

    const update = () => {
      const progress = (window.scrollY - start()) / slideHeight()
      setActive(Math.min(slides.length - 1, Math.max(0, Math.round(progress))))
    }

    // Past the last slide this lands where the section ends and the grid starts.
    const scrollToSlide = (index: number) =>
      window.scrollTo({
        top: start() + index * slideHeight(),
        // "auto" would follow the page's scroll-smooth class and still animate.
        behavior: reducedMotion.matches ? "instant" : "smooth",
      })

    next?.addEventListener("click", () => scrollToSlide(active + 1))

    // Up/down move one slide while the carousel is pinned; at either end the
    // keys fall through to normal page scrolling.
    document.addEventListener("keydown", event => {
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return
      const target = event.target as HTMLElement | null
      if (target?.closest("input, textarea, select, [contenteditable]")) return
      const pinnedEnd = start() + (slides.length - 1) * slideHeight()
      if (window.scrollY < start() - 1 || window.scrollY > pinnedEnd + 1) return
      const index = active + (event.key === "ArrowDown" ? 1 : -1)
      if (index < 0 || index >= slides.length) return
      event.preventDefault()
      scrollToSlide(index)
    })

    let frameRequest: number | null = null
    window.addEventListener(
      "scroll",
      () => {
        if (frameRequest !== null) return
        frameRequest = window.requestAnimationFrame(() => {
          frameRequest = null
          update()
        })
      },
      { passive: true }
    )
    window.addEventListener("resize", update)
    update()
  }
</script>
