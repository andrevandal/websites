---
import { SunIcon, SunPicture } from "@vandal-websites/sun-ui/astro"
import Heading from "@components/Heading.astro"
import { mediaSource } from "@vandal-websites/sun-ui-emdash"
import type { BylineSummary } from "emdash"

type Props = {
  title: string
  byline: BylineSummary | null
  publishedAt: Date | null
  readingMinutes: number
}

const { title, byline, publishedAt, readingMinutes } = Astro.props

const formattedDate = publishedAt
  ? new Intl.DateTimeFormat("pt-BR", {
      day: "numeric",
      month: "long",
      year: "numeric",
    }).format(publishedAt)
  : undefined

const photo = byline?.avatarStorageKey
  ? {
      id: byline.avatarMediaId ?? "",
      meta: { storageKey: byline.avatarStorageKey },
      alt: byline.avatarAlt ?? byline.displayName,
    }
  : undefined
---

<header
  class="border-light-mushroom/50 relative border-b bg-white pt-8 pb-8 lg:pt-[72px] lg:pb-12"
>
  <div class="relative container flex flex-col gap-4">
    <SunIcon
      name="writing-book"
      width={74}
      height={59}
      class="text-light-mushroom pointer-events-none absolute top-0 right-4 lg:hidden"
      aria-hidden="true"
    />
    <SunIcon
      name="writing-book"
      width={180}
      height={143}
      class="text-light-mushroom pointer-events-none absolute top-2 right-4 hidden lg:block"
      aria-hidden="true"
    />
    <a
      href="/blog"
      class="text-brown-leather w-fit font-sans text-sm font-medium lg:text-base"
    >
      ← Blog
    </a>
    <Heading
      as="h1"
      class="text-tobago max-w-[34ch] font-serif text-2xl leading-[1.2] font-bold lg:max-w-[560px] lg:text-[3rem]"
    >
      {title}
    </Heading>
    <div class="flex items-center gap-4">
      {
        photo ? (
          <SunPicture
            src={mediaSource(photo, Astro)}
            alt={photo.alt}
            width={56}
            height={56}
            quality={90}
            wrapperClass="size-14 shrink-0 overflow-hidden rounded-full"
            class="size-full object-cover"
          />
        ) : (
          <div
            class="bg-light-mushroom size-14 shrink-0 rounded-full"
            aria-hidden="true"
          />
        )
      }
      <div class="flex flex-col">
        {
          byline && (
            <span class="text-tobago font-sans text-base font-semibold">
              {byline.displayName}
            </span>
          )
        }
        <span class="text-body-small text-brown-leather">
          {formattedDate}
          {formattedDate && " · "}
          {readingMinutes} min de leitura
        </span>
      </div>
    </div>
  </div>
</header>
