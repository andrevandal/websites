---
import { getEmDashEntry } from "emdash"
import { HOME_PAGE_SLUG } from "@/cms/pages"
import CmsPage from "@components/CmsPage.astro"

const { entry: page, cacheHint } = await getEmDashEntry("pages", HOME_PAGE_SLUG)
if (!page) return new Response(null, { status: 404 })
if (Astro.cache?.enabled) Astro.cache.set(cacheHint)
---

<CmsPage page={page} />
