---
import "../styles/global.css"

import { Font } from "astro:assets"
import { getSecret, S3_PUBLIC_URL } from "astro:env/server"
import type { HTMLAttributes } from "astro/types"

import {
  SunAnimateOnScroll as AnimateOnScroll,
  SunLayout as Layout,
  assetUrl,
} from "@vandal-websites/sun-ui/astro"
import Navigation from "@components/Navigation.astro"
import TheFooter from "@components/TheFooter.astro"
import { siteConfig } from "@/data/site"

type Props = {
  title: string
  description?: string
  image?: string
  url: URL
  schema?: Record<string, unknown>
  links?: HTMLAttributes<"link">[]
}

const {
  title,
  description = siteConfig.description,
  schema,
  links,
  url,
  image = siteConfig.defaultSocialImage,
} = Astro.props
---

<Layout
  title={title}
  description={description}
  image={/^https?:/.test(image)
    ? image
    : assetUrl(getSecret, image, S3_PUBLIC_URL)}
  url={url}
  schema={schema}
  links={links}
  themeColor="#1f1e1e"
>
  <Font cssVariable="--font-lexend" preload slot="close-head" />
  <Navigation />
  <slot />
  <TheFooter />
  <AnimateOnScroll slot="close-body" />
</Layout>
