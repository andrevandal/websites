---
import Logo from "./Logo.astro"
import { waLink } from "@vandal-websites/sun-ui"
import { siteConfig } from "#/data/site"

const currentYear = new Date().getFullYear()
---

<footer class="flex w-full flex-col items-center bg-gray-900">
  <div class="container flex flex-col gap-10 pt-12 pb-6 xl:flex-row xl:pb-12">
    <div class="order-3 flex flex-1 flex-col gap-4 xl:order-0">
      <Logo />
      <p class="text-base text-balance text-gray-300">
        Transportugal Ltda. Transporte de cargas fracionadas e fechadas entre
        São Paulo e o Espírito Santo.
      </p>
    </div>

    <div class="order-1 flex flex-1 flex-col gap-6 text-base xl:order-0">
      <p class="font-medium tracking-[1.6px] text-[#d98b92]">UNIDADES</p>
      <div class="flex flex-col gap-4">
        <p class="font-medium text-white">Matriz - Guarulhos (SP)</p>
        <div class="flex flex-col gap-1 text-gray-300">
          <a
            class="underline"
            href="https://www.google.com/maps/search/?api=1&query=Rua+Birigui%2C+1117+-+Cidade+Jardim+Cumbica%2C+Guarulhos+-+SP%2C+07180-310"
            >Rua Birigui, 1117 - Cidade Jardim Cumbica</a
          >
          <p>CEP 07180-310</p>
          <a href="tel:+551123580475">Telefone: (11) 2358-0475</a>
        </div>
      </div>
      <div class="flex flex-col gap-4">
        <p class="font-medium text-white">Filial - Cariacica (ES)</p>
        <div class="flex flex-col gap-1 text-gray-300">
          <a
            class="underline"
            href="https://www.google.com/maps/search/?api=1&query=Rua+das+Imbu%C3%ADas%2C+81+-+Santo+Ant%C3%B4nio%2C+Cariacica+-+ES%2C+29156-849"
            >Rua das Imbuías, 81 - Santo Antônio</a
          >
          <p>CEP 29156-849</p>
          <a href="tel:+5527997079958">Telefone: (27) 99707-9958</a>
        </div>
      </div>
    </div>

    <div class="order-2 flex flex-1 flex-col gap-6 xl:order-0">
      <p class="text-base font-medium tracking-[1.6px] text-[#d98b92]">
        FALE CONOSCO
      </p>
      <div class="flex flex-col gap-4">
        <p class="text-base font-medium text-white">Horário de atendimento</p>
        <p class="text-base text-gray-300">Das 9h às 18h</p>
      </div>
      <div class="flex flex-col gap-4 text-base">
        <p class="font-medium text-white">Cotação e acompanhar carga</p>
        <div class="flex flex-col gap-1 text-gray-300">
          <a
            href={waLink(
              siteConfig.whatsappOffice,
              "Olá! Gostaria de solicitar uma cotação."
            )}>WhatsApp (11) 2358-0464</a
          >
          <a
            href="mailto:comercial@transportugal.com.br?subject=Solicita%C3%A7%C3%A3o%20de%20cota%C3%A7%C3%A3o"
            >comercial@transportugal.com.br</a
          >
        </div>
      </div>
    </div>
  </div>

  <div
    class="container flex items-center justify-center border-t border-gray-800 py-6"
  >
    <div
      class="flex w-full flex-col justify-between gap-4 text-base xl:flex-row xl:items-center"
    >
      <div class="flex flex-col gap-2 text-pretty text-white">
        <p>Transportugal {currentYear}. Todos os direitos reservados.</p>
        <p>CNPJ 66.225.530/0001-46 - Inscrição Estadual 159.228.453.116</p>
      </div>
      <div class="flex gap-1">
        <p class="text-white">Feito por</p>
        <a class="text-red font-medium" href="https://pedrohenridesign.com.br/"
          >Pedro Henri</a
        >
        <p class="text-white">&</p>
        <a class="text-red font-medium" href="https://andrevandal.dev/"
          >André Vandal</a
        >
      </div>
    </div>
  </div>
</footer>
