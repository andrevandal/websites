---
import { cn } from "@vandal-websites/sun-ui"
import type { Polymorphic } from "astro/types"

type AllowedTags = "h1" | "h2" | "h3" | "h4" | "h5" | "span" | "p"

type Props<Tag extends AllowedTags = AllowedTags> = Polymorphic<{
  as: Tag
}> & {
  variant?: "light" | "dark"
}

const {
  as: Tag = "h2",
  class: className,
  variant = "light",
  ...attrs
} = Astro.props
---

<Tag
  class={cn(
    "text-2xl leading-tight font-medium tracking-[-0.72px] lg:text-[40px] lg:tracking-[-1.2px]",
    {
      "text-gray-900": variant === "light",
      "text-white": variant === "dark",
    },
    className
  )}
  {...attrs}
>
  <slot />
</Tag>
