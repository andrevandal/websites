---
import "@/styles/global.css"
import { getSecret } from "astro:env/server"
import type { HTMLAttributes } from "astro/types"
import { SunLayout, runtimeGtag } from "@vandal-websites/sun-ui/astro"
import { imageUrl } from "@/utils/images"
import TheHeader from "@/components/TheHeader.astro"
import TheFooter from "@/components/TheFooter.astro"

type Props = {
  title: string
  description: string
  image: string
  url: URL
  schema?: Record<string, unknown>
  links?: HTMLAttributes<"link">[]
}

const { title, description, image, url, schema, links } = Astro.props
const bellyPatternUrl = imageUrl("images/belly-pattern.png", {
  format: "auto",
  quality: 90,
})
const styleAttr = `--belly-pattern: url("${bellyPatternUrl}")`
---

<SunLayout
  title={title}
  description={description}
  url={url}
  schema={schema}
  links={links}
  image={new URL(image, Astro.site ?? url).toString()}
  gtag={runtimeGtag(getSecret)}
  style={styleAttr}
>
  <Fragment slot="close-head">
    <link
      href="/css/fonts.css"
      rel="preload"
      as="style"
      onload="this.rel='stylesheet'"
    />
    <noscript><link rel="stylesheet" href="/css/fonts.css" /></noscript>
  </Fragment>
  <TheHeader>
    <slot name="header" />
  </TheHeader>
  <slot />
  <TheFooter>
    <slot name="footer" />
  </TheFooter>
</SunLayout>
