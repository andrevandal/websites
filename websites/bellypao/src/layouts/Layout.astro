---
import "@/styles/global.css"
import { Font } from "astro:assets"
import type { HTMLAttributes } from "astro/types"
import { SunLayout } from "@vandal-websites/sun-ui/astro"
import { imageUrl } from "@/utils/images"
import TheHeader from "@/components/TheHeader.astro"
import TheFooter from "@/components/TheFooter.astro"

type Props = {
  title: string
  description: string
  image: string
  url: URL
  schema?: Record<string, unknown>
  links?: HTMLAttributes<"link">[]
}

const { title, description, image, url, schema, links } = Astro.props
const bellyPatternUrl = imageUrl("images/belly-pattern.png", {
  format: "auto",
  quality: 90,
})
const styleAttr = `--belly-pattern: url("${bellyPatternUrl}")`
---

<SunLayout
  title={title}
  description={description}
  url={url}
  schema={schema}
  links={links}
  image={new URL(image, Astro.site ?? url).toString()}
  gtag={{
    // Only the canonical (production) host reports to Analytics.
    gtagId: url.host === Astro.site?.host ? "G-NJDJVMT0ES" : undefined,
  }}
  style={styleAttr}
>
  <Fragment slot="close-head">
    <Font cssVariable="--belly-font-fields" preload />
    <Font cssVariable="--belly-font-quicksand" preload />
  </Fragment>
  <TheHeader>
    <slot name="header" />
  </TheHeader>
  <slot />
  <TheFooter>
    <slot name="footer" />
  </TheFooter>
</SunLayout>
