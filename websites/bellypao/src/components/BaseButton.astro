---
import { SunButton, SunIcon } from "@vandal-websites/sun-ui/astro"

const variantClasses = {
  primary: "btn-primary",
  "primary-outline": "btn-primary-outline",
  "secondary-outline": "btn-secondary-outline",
}
const sizeClasses = {
  xs: "btn-xs",
  sm: "btn-sm",
  base: "btn-base",
}

type Sizes = keyof typeof sizeClasses

type Props = {
  href?: string
  variant: keyof typeof variantClasses
  icon?: string
  reverse?: boolean
  block?: boolean
  centered?: boolean
  size?: Sizes
  class?: string
}

const {
  href,
  variant,
  icon,
  reverse,
  size = "base",
  block = false,
  centered = false,
  class: className = "",
} = Astro.props
---

<SunButton
  as="a"
  href={href}
  block={block}
  centered={centered}
  className={[
    "belly-button",
    variantClasses[variant],
    sizeClasses[size],
    reverse ? "btn-reverse" : "",
    className,
  ].join(" ")}
>
  <slot />
  {icon && <SunIcon slot="suffix" name={icon} width={20} height={20} />}
</SunButton>

<style>
  @reference "../styles/global.css";

  :global(.belly-button) {
    @apply gap-x-2 rounded-lg px-6 py-4 text-base font-semibold transition-all duration-200 ease-out;
  }
  :global(.belly-button.btn-base) {
    @apply h-14 px-6 py-4;
  }
  :global(.belly-button.btn-sm) {
    @apply h-12 px-3 py-3;
  }
  :global(.belly-button.btn-xs) {
    @apply h-10 px-6 py-2;
  }
  :global(.belly-button.btn-primary) {
    @apply bg-[#FFAA33] text-[#503C2D] ring-4 ring-transparent hover:ring-[#FFAA33]/50;
  }
  :global(.belly-button.btn-primary-outline) {
    @apply hover:text-brown-700 border border-[#FFAA33] text-[#FFAA33] hover:bg-[#FFAA33];
  }
  :global(.belly-button.btn-secondary-outline) {
    @apply border-brown-700 text-brown-700 hover:bg-brown-700 border hover:text-[#FFECCC];
  }
  :global(.belly-button.btn:not(.btn-center)) {
    @apply justify-start;
  }
  :global(.belly-button.btn.btn-center) {
    @apply justify-center;
  }
  :global(.belly-button.btn.btn-reverse) {
    @apply flex-row-reverse;
  }
</style>
