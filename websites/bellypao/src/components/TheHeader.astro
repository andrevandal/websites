---
import { SunPicture } from "@vandal-websites/sun-ui/astro"
import { waLink } from "@vandal-websites/sun-ui"
import { fileUrl } from "#/utils/images"
import BaseButton from "#/components/BaseButton.astro"
import { WA_NUMBER } from "#/data/contact"
import { heroDesktop, heroMobile } from "#/data/hero"
---

<header id="topo" class="block">
  <div class="fixed top-0 z-20 w-full">
    <nav
      class="container grid grid-cols-[1fr_40px] flex-wrap gap-x-2 pt-4 lg:flex lg:flex-row lg:justify-between lg:pb-4"
    >
      <a href="/#topo" class="block">
        <SunPicture
          src={fileUrl("images/logo-bellypao.h144.png")}
          alt="Logo Belly Pão"
          width={160}
          height={40}
          quality={90}
          format="auto"
          densities={[1, 1.5, 2, 3]}
          placeholder={false}
          loading="eager"
          wrapperClass="h-10 w-40"
          class="size-full object-contain"
        />
      </a>
      <input class="hidden" type="checkbox" id="menu-opened" />
      <label id="menu-button" for="menu-opened">
        <span class="icon"></span>
      </label>
      <ul id="menu">
        <li>
          <a class="nav-link" href="/#diferencial">Diferencial</a>
        </li>
        <li>
          <a class="nav-link" href="/#servicos">Serviços</a>
        </li>
        <li>
          <a class="nav-link" href="/#produtos">Produtos</a>
        </li>
        <li>
          <a class="nav-link" href="/#quem-somos">Quem somos</a>
        </li>
        <li>
          <BaseButton
            href={waLink(WA_NUMBER)}
            variant="primary-outline"
            icon="whatsapp"
            size="xs"
            block
            centered>Fale conosco</BaseButton
          >
        </li>
      </ul>
    </nav>
  </div>
  <div class="bg-brown-700 relative flex flex-col">
    <SunPicture
      src={fileUrl(heroMobile.path)}
      width={heroMobile.width}
      height={heroMobile.height}
      breakpoints={heroMobile.breakpoints}
      sizes={heroMobile.sizes}
      sources={[
        {
          media: heroDesktop.media,
          src: fileUrl(heroDesktop.path),
          width: heroDesktop.width,
          height: heroDesktop.height,
          breakpoints: heroDesktop.breakpoints,
        },
      ]}
      alt="Pão com manteiga"
      loading="eager"
      fetchpriority="high"
      quality={90}
      format="auto"
      placeholder={false}
      wrapperClass="absolute right-0 bottom-0 left-0 opacity-70 mix-blend-lighten"
      class="mt-auto aspect-375/278 h-auto w-full object-cover sm:mx-auto sm:aspect-640/276 sm:max-w-160 sm:px-8 lg:max-w-5xl xl:max-w-7xl"
    />
    <div class="relative z-2 container mt-18">
      <slot />
    </div>
  </div>
</header>
<script>
  import { useHeader } from "@vandal-websites/sun-ui"

  useHeader("#topo .fixed")
</script>
<style>
  @reference "../styles/global.css";

  #menu-button {
    @apply border-brown-800 inline-flex h-10 w-10 cursor-pointer items-center justify-center justify-self-end rounded-lg border p-2 select-none;
    @apply lg:hidden;
  }

  .icon {
    @apply relative block h-0.5 w-4 bg-[#FFAA33] transition-colors ease-out;
  }

  .icon:before,
  .icon:after {
    @apply absolute block h-full w-full bg-[#FFAA33] transition-all ease-out content-[''];
  }

  .icon:before {
    @apply top-1.25;
  }

  .icon:after {
    @apply -top-1.25;
  }

  #menu {
    @apply transition-max-height col-span-2 clear-both box-border max-h-0 overflow-hidden pt-4 duration-200 ease-out will-change-auto;
    @apply lg:flex lg:max-h-fit lg:items-center lg:justify-center lg:gap-x-2 lg:pt-0;
  }

  #menu li:last-of-type {
    @apply mt-2 lg:mt-0 lg:ml-4;
  }
  #menu li:last-of-type :global(a) {
    @apply h-10;
  }

  #menu-opened:checked ~ #menu {
    @apply pb-4;
    max-height: 282px;
  }

  #menu-opened:checked ~ #menu-button .icon {
    background: transparent;
  }

  #menu-opened:checked ~ #menu-button .icon:before {
    top: 0;
    transform: rotate(-45deg);
  }

  #menu-opened:checked ~ #menu-button .icon:after {
    top: 0;
    transform: rotate(45deg);
  }

  .nav-link {
    @apply inline-flex h-12 w-full items-center rounded-lg px-2 font-semibold text-[#FFECCC] transition-colors ease-out hover:bg-[#FFECCC]/10;
    @apply lg:h-10 lg:w-fit lg:px-4 lg:py-3;
  }

  #topo .fixed.actived {
    @apply bg-brown-700/90 backdrop-blur;
  }

  #topo .fixed:has(#menu-opened:checked) {
    @apply bg-brown-700/90 rounded-b-lg backdrop-blur;
  }
</style>
