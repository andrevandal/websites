---
import Layout from "#/layouts/Layout.astro"
import CalculatorSection from "#/components/CalculatorSection.astro"
import Products from "#/components/Products.astro"
import Reseller from "#/components/Reseller.astro"
import Satisfaction from "#/components/Satisfaction.astro"
import Solutions from "#/components/Solutions.astro"
import TheFooter from "#/components/TheFooter.astro"
import TheHeader from "#/components/TheHeader.astro"

const title = "Gru Ice - A fábrica de gelo para os bons momentos!"
const description =
  "Encontre gelo da melhor qualidade na GRU ICE. Nós garantimos um produto seguro e cuidado em cada gota, produzido de forma responsável. Desfrute da nossa entrega eficiente em Guarulhos e região."
---

<Layout title={title} description={description}>
  <TheHeader />
  <main>
    <Products />
    <CalculatorSection />
    <Solutions />
    <Satisfaction />
    <Reseller />
  </main>
  <TheFooter />
</Layout>
