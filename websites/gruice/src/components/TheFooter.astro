---
import { SunIcon } from "@vandal-websites/sun-ui/astro"
import { waLink } from "@vandal-websites/sun-ui"
import {
  ADDRESS,
  EMAIL,
  INSTAGRAM_URL,
  PHONE_LABEL,
  WA_DEFAULT_MESSAGE,
  WA_NUMBER,
} from "#/data/contact"
import { fileUrl } from "#/utils/images"

const whatsappUrl = waLink(WA_NUMBER, WA_DEFAULT_MESSAGE)
const socialClass =
  "flex items-center justify-center rounded-lg border border-true-gray-100 p-3"
const socials = [
  {
    href: INSTAGRAM_URL,
    icon: "instagram",
    label: "botão de ir para o instagram",
  },
  {
    href: whatsappUrl,
    icon: "whatsapp-outline",
    label: "botão de ir para o whatsapp",
  },
]
---

<footer class="bg-true-gray-800 text-water-50 flex flex-col gap-2">
  <section
    class="mx-auto flex w-full max-w-[1124px] flex-col gap-3 px-4 py-8 text-center lg:flex-row lg:items-end lg:justify-between lg:px-0"
  >
    <section
      class="flex flex-1 flex-col items-center gap-3 text-center lg:items-start lg:text-left"
    >
      <span class="font-semibold">Matriz</span>
      <span class="flex items-center gap-2 lg:items-start">
        <SunIcon
          name="location"
          class="text-disco-ball-300 h-6 w-6"
          width={24}
          height={24}
        />
        {ADDRESS}
      </span>
      <span class="font-semibold">Atendimento</span>
      <address class="not-italic">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 lg:justify-start"
        >
          <SunIcon
            name="whatsapp-outline"
            class="text-disco-ball-300 h-6 w-6"
            width={24}
            height={24}
          />{PHONE_LABEL}</a
        >
        <a
          href={`mailto:${EMAIL}`}
          class="flex items-center justify-center gap-2 lg:justify-start"
        >
          <SunIcon
            name="email"
            class="text-disco-ball-300 h-6 w-6"
            width={24}
            height={24}
          />{EMAIL}</a
        >
      </address>
      <span class="font-semibold">Nossas redes</span>
      <ul class="flex items-center justify-center gap-2 py-2">
        {
          socials.map(social => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class={socialClass}
              >
                <span class="sr-only">{social.label}</span>
                <SunIcon
                  name={social.icon}
                  class="h-5 w-5"
                  width={20}
                  height={20}
                />
              </a>
            </li>
          ))
        }
      </ul>
    </section>
    <section
      class="group flex flex-1 flex-col items-center justify-center gap-2 lg:items-end"
    >
      <a href="#header"
        ><span class="sr-only">Logo da Gruice</span>
        <img
          src={fileUrl("images/mobile/logo-white.svg")}
          alt="logo da empresa"
          width="155"
          height="12"
          class="h-12 w-[155px] saturate-0 duration-300 group-hover:saturate-100"
        />
      </a>
      <span>2023 © GRU ICE. Todos os direitos reservados</span>
    </section>
  </section>
  <section class="bg-true-gray-900">
    <div
      class="mx-auto flex max-w-[1124px] flex-col items-center gap-2 p-4 text-center lg:flex-row-reverse lg:justify-between lg:px-0"
    >
      <a
        href="http://pedrohenri.design"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="33"
          height="32"
          fill="none"
        >
          <path
            fill="#F6FDFE"
            d="M30.215 0H2.785A2.286 2.286 0 0 0 .5 2.286v27.429A2.286 2.286 0 0 0 2.785 32h27.43a2.286 2.286 0 0 0 2.285-2.285V2.286A2.286 2.286 0 0 0 30.215 0Zm-19.43 14.095V27.2a.228.228 0 0 1-.228.229H7.205a.229.229 0 0 1-.229-.229V14.18c0-5.272 4.247-9.605 9.519-9.608 4.51-.003 8.29 3.13 9.277 7.338a.229.229 0 0 1-.223.28h-3.5a.228.228 0 0 1-.213-.145 5.715 5.715 0 0 0-11.05 2.05ZM26.024 27.2a.229.229 0 0 1-.229.229h-3.352a.228.228 0 0 1-.228-.229v-5.485a9.48 9.48 0 0 1-3.81 1.713V27.2a.228.228 0 0 1-.229.229h-3.352a.228.228 0 0 1-.229-.229V12.42c0-.127.102-.23.229-.23h3.352c.127 0 .229.103.229.23v7.064a5.73 5.73 0 0 0 3.43-3.339.228.228 0 0 1 .212-.145h3.748c.126 0 .229.102.229.229V27.2Z"
          ></path>
        </svg>
      </a>
      <span
        >Desenvolvido com 💙 por <a
          href="http://pedrohenri.design"
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold">Pedro Henri</a
        > e <a
          href="https://lucasribeiro.dev.br"
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold">Lucas Ribeiro</a
        ></span
      >
    </div>
  </section>
</footer>
