  "type": "module",
  "scripts": {
    "moon": "moon --color",
    "graph": "moon tg",
    "generate:transportugal-cities": "bun scripts/generate-transportugal-cities.ts",
    "check": "bun run format && bun run lint && bun run typecheck && bun run test && moon run :coverage && bun run docs",
    "postinstall": "bun sync",
    "sync": "moon sync projects",
    "deploy": "bun scripts/deploy.ts",
    "dev": "bun scripts/dev.ts",
    "website:new": "bun scripts/new-website.ts",
    "optimize:svg": "bun scripts/optimizeSvg.ts",
    "typecheck": "moon run *:typecheck",
    "test": "moon run *:test",
    "test:scripts": "bun test scripts",
    "lint": "oxlint . && eslint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix . && eslint --no-error-on-unmatched-pattern --fix",
    "format": "oxfmt . --check && prettier --check --no-error-on-unmatched-pattern **/*.astro",
    "format:fix": "oxfmt . --write && prettier --write --no-error-on-unmatched-pattern **/*.astro",
    "docs": "bun scripts/docs-check.ts && bun scripts/skills-check.ts && bun node_modules/agents-md-lint/dist/cli.js --strict AGENTS.md",
    "skills:install": "bunx skills experimental_install",
    "skills:update": "bunx skills update -p -y"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:tools",
